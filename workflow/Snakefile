# ══════════════════════════════════════════════════════════════════════════════
# COCOA Truth-Particle Tokenization
# ══════════════════════════════════════════════════════════════════════════════
# Continuous features (fixed in heptokens.data.cocoa_truthpart): pt=0, eta=1,
# phi=2, e=3, so the ReconstructionMonitor default pt/deta/dphi indices (0/1/2)
# apply. The 3-way particle class (charged/neutral-hadron/photon) is carried as a
# separate integer `class_labels` channel and handled by the model's categorical
# head (embedding on input, cross-entropy on output, argmax to decode).
COCOA_TRUTHPART_CST_FN = f"{WORKSPACE}/resources/cocoa_truthpart_log_standard.joblib"
COCOA_TRUTHPART_MAX_CSTS = 16
COCOA_TRUTHPART_NUM_CLASSES = 3
COCOA_TRUTHPART_CLASS_EMBED_DIM = 8

# Single operating point (list-based so this trivially extends to a scan later).
cocoa_truthpart_codebook_sizes = [128]
cocoa_truthpart_codebook_dims = [8]
cocoa_truthpart_num_quantizers = [3]
cocoa_truthpart_learning_rates = [0.001]

cocoa_truthpart_scan_configs = []
for cb, cd, nq, lr in product(
    cocoa_truthpart_codebook_sizes,
    cocoa_truthpart_codebook_dims,
    cocoa_truthpart_num_quantizers,
    cocoa_truthpart_learning_rates,
):
    name = f"cocoa_truthpart_cb{cb}_cd{cd}_nq{nq}_lr{lr}"
    cocoa_truthpart_scan_configs.append({"cb": cb, "cd": cd, "nq": nq, "lr": lr, "name": name})

cocoa_truthpart_scan_names = [c["name"] for c in cocoa_truthpart_scan_configs]
cocoa_truthpart_scan_lookup = {c["name"]: c for c in cocoa_truthpart_scan_configs}

rule cocoa_truthpart_scaler:
    output:
        COCOA_TRUTHPART_CST_FN,
    shell:
        """
        pixi run python scripts/fit_cocoa_truthpart_scaler.py \
            --data_dir {COCOA_DATA_DIR} \
            --max_csts {COCOA_TRUTHPART_MAX_CSTS} \
            --output {COCOA_TRUTHPART_CST_FN}
        """

rule all_cocoa_truthpart:
    input:
        expand(cocoa_output_dir / "truthpart/{cocoa_name}/SUCCESS.txt", cocoa_name=cocoa_truthpart_scan_names),

rule train_cocoa_truthpart:
    input:
        cst_fn = ancient(COCOA_TRUTHPART_CST_FN),
    output:
        cocoa_output_dir / "truthpart/{cocoa_name}/SUCCESS.txt",
        ckpt = cocoa_output_dir / "truthpart/{cocoa_name}/checkpoints/best.ckpt",
    params:
        output_dir = cocoa_output_dir,
        codebook_size = lambda wc: cocoa_truthpart_scan_lookup[wc.cocoa_name]["cb"],
        codebook_dim = lambda wc: cocoa_truthpart_scan_lookup[wc.cocoa_name]["cd"],
        num_quantizers = lambda wc: cocoa_truthpart_scan_lookup[wc.cocoa_name]["nq"],
        learning_rate = lambda wc: cocoa_truthpart_scan_lookup[wc.cocoa_name]["lr"],
        slurm = SLURM,
    wildcard_constraints:
        cocoa_name = "|".join(cocoa_truthpart_scan_names),
    shell:
        """
        {params.slurm} -J {wildcards.cocoa_name} \
            -o {params.output_dir}/truthpart/{wildcards.cocoa_name}/slurm_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=truthpart \
                network_name={wildcards.cocoa_name} \
                model=transformer_vqvae \
                datamodule=cocoa_truthpart \
                datamodule.data_dir={COCOA_DATA_DIR} \
                datamodule.max_csts={COCOA_TRUTHPART_MAX_CSTS} \
                datamodule.num_events=5000000 \
                model.encoder.model.d_model={cocoa_encoder_size[d_model]} \
                model.encoder.model.n_heads={cocoa_encoder_size[n_heads]} \
                model.encoder.model.num_layers={cocoa_encoder_size[num_layers]} \
                model.encoder.model.dim_feedforward={cocoa_encoder_size[dim_feedforward]} \
                model.decoder.model.d_model={cocoa_encoder_size[d_model]} \
                model.decoder.model.n_heads={cocoa_encoder_size[n_heads]} \
                model.decoder.model.num_layers={cocoa_encoder_size[num_layers]} \
                model.decoder.model.dim_feedforward={cocoa_encoder_size[dim_feedforward]} \
                model.codebook_size={params.codebook_size} \
                model.codebook_dim={params.codebook_dim} \
                model.num_quantizers={params.num_quantizers} \
                model.learning_rate={params.learning_rate} \
                model.optimizer.lr={params.learning_rate} \
                +model.commitment_weight=1.0 \
                +model.num_classes={COCOA_TRUTHPART_NUM_CLASSES} \
                +model.class_embed_dim={COCOA_TRUTHPART_CLASS_EMBED_DIM} \
                trainer.max_epochs=50 \
                trainer.check_val_every_n_epoch=1 \
                trainer.val_check_interval=1.0 \
                trainer.limit_val_batches=1.0 \
                +trainer.num_sanity_val_steps=0 \
                trainer.gradient_clip_val=1.0 \
                trainer.enable_progress_bar=false \
                callbacks=encode_cocoa \
                callbacks.early_stopping.patience=15 \
                callbacks.reconstruction_monitor.log_every_n_epochs=5 \
                +callbacks.reconstruction_monitor.max_batches=100 \
                datamodule.transforms.preprocess.cst_fn.filename={COCOA_TRUTHPART_CST_FN}"
        """

rule all_cocoa_truthpart_test:
    input:
        expand(cocoa_output_dir / "truthpart/{cocoa_name}/TEST_SUCCESS.txt", cocoa_name=cocoa_truthpart_scan_names),

