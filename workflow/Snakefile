rule train_design_topos:
    input:
        cst_fn = _design_cst_fn_input(design_topos),
    output:
        cocoa_output_dir / "{design_project}/{design_name}/SUCCESS.txt",
        ckpt = cocoa_output_dir / "{design_project}/{design_name}/checkpoints/best.ckpt",
    params:
        output_dir = cocoa_output_dir,
        codebook_size = _design_param(design_topos, "cb"),
        codebook_dim = _design_param(design_topos, "cd"),
        num_quantizers = _design_param(design_topos, "nq"),
        cst_fn = _design_param(design_topos, "cst_fn"),
        extra = _design_param(design_topos, "extra"),
        max_epochs = _design_param(design_topos, "max_epochs"),
        patience = _design_param(design_topos, "patience"),
        slurm = _design_param(design_topos, "slurm"),
    wildcard_constraints:
        design_project = "|".join(sorted({c["project"] for c in design_topos.values()})),
        design_name = "|".join(design_topos),
    shell:
        """
        {params.slurm} -J {wildcards.design_name} \
            -o {params.output_dir}/{wildcards.design_project}/{wildcards.design_name}/slurm_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name={wildcards.design_project} \
                network_name={wildcards.design_name} \
                model=transformer_vqvae \
                datamodule=cocoa_topos \
                datamodule.data_dir={COCOA_DATA_DIR} \
                datamodule.num_events=5000000 \
                model.encoder.model.d_model={cocoa_encoder_size[d_model]} \
                model.encoder.model.n_heads={cocoa_encoder_size[n_heads]} \
                model.encoder.model.num_layers={cocoa_encoder_size[num_layers]} \
                model.encoder.model.dim_feedforward={cocoa_encoder_size[dim_feedforward]} \
                model.decoder.model.d_model={cocoa_encoder_size[d_model]} \
                model.decoder.model.n_heads={cocoa_encoder_size[n_heads]} \
                model.decoder.model.num_layers={cocoa_encoder_size[num_layers]} \
                model.decoder.model.dim_feedforward={cocoa_encoder_size[dim_feedforward]} \
                model.codebook_size={params.codebook_size} \
                model.codebook_dim={params.codebook_dim} \
                model.num_quantizers={params.num_quantizers} \
                model.learning_rate=0.001 \
                model.optimizer.lr=0.001 \
                +model.commitment_weight=1.0 \
                trainer.max_epochs={params.max_epochs} \
                trainer.check_val_every_n_epoch=1 \
                trainer.val_check_interval=1.0 \
                trainer.limit_val_batches=1.0 \
                +trainer.num_sanity_val_steps=0 \
                trainer.gradient_clip_val=1.0 \
                trainer.enable_progress_bar=false \
                callbacks=encode_cocoa \
                callbacks.early_stopping.patience={params.patience} \
                callbacks.reconstruction_monitor.log_every_n_epochs=5 \
                +callbacks.reconstruction_monitor.max_batches=100 \
                datamodule.transforms.preprocess.cst_fn.filename={params.cst_fn} \
                {params.extra}"
        """

rule test_design_topos:
    input:
        success = cocoa_output_dir / "{design_project}/{design_name}/SUCCESS.txt",
        ckpt = cocoa_output_dir / "{design_project}/{design_name}/checkpoints/best.ckpt",
    output:
        cocoa_output_dir / "{design_project}/{design_name}/TEST_SUCCESS.txt",
    params:
        output_dir = cocoa_output_dir,
        codebook_size = _design_param(design_topos, "cb"),
        codebook_dim = _design_param(design_topos, "cd"),
        num_quantizers = _design_param(design_topos, "nq"),
