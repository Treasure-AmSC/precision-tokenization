# ══════════════════════════════════════════════════════════════════════════════
# COCOA Track Tokenization
# ══════════════════════════════════════════════════════════════════════════════
COCOA_DATA_DIR = "/fs/ddn/sdf/group/atlas/d/jkrupa/treasure/4m/data_new/COCOA_samples_singlejet"
COCOA_CST_FN = f"{WORKSPACE}/resources/cocoa_cst_log_standard.joblib"
cocoa_output_dir = WORKSPACE / "results" / "cocoa_scan"

# ── COCOA scan grid ──────────────────────────────────────────────────────────
cocoa_codebook_sizes = [64, 256, 1024, 4096]
cocoa_codebook_dims = [2, 4, 8]
cocoa_num_quantizers = [2, 3, 4]
cocoa_learning_rates = [0.001]
cocoa_encoder_size = {
    "d_model": 128, "n_heads": 8, "num_layers": 4, "dim_feedforward": 512,
}

cocoa_scan_configs = []
for cb, cd, nq, lr in product(
    cocoa_codebook_sizes, cocoa_codebook_dims, cocoa_num_quantizers, cocoa_learning_rates,
):
    name = f"cocoa_tracks_cb{cb}_cd{cd}_nq{nq}_lr{lr}"
    cocoa_scan_configs.append({"cb": cb, "cd": cd, "nq": nq, "lr": lr, "name": name})

cocoa_scan_names = [c["name"] for c in cocoa_scan_configs]
cocoa_scan_lookup = {c["name"]: c for c in cocoa_scan_configs}

rule all_cocoa_tracks:
    input:
        expand(cocoa_output_dir / "tracks/{cocoa_name}/SUCCESS.txt", cocoa_name=cocoa_scan_names),

rule train_cocoa_tracks:
    output:
        cocoa_output_dir / "tracks/{cocoa_name}/SUCCESS.txt",
        ckpt = cocoa_output_dir / "tracks/{cocoa_name}/checkpoints/best.ckpt",
    params:
        output_dir = cocoa_output_dir,
        codebook_size = lambda wc: cocoa_scan_lookup[wc.cocoa_name]["cb"],
        codebook_dim = lambda wc: cocoa_scan_lookup[wc.cocoa_name]["cd"],
        num_quantizers = lambda wc: cocoa_scan_lookup[wc.cocoa_name]["nq"],
        learning_rate = lambda wc: cocoa_scan_lookup[wc.cocoa_name]["lr"],
        slurm = SLURM,
    wildcard_constraints:
        cocoa_name = "|".join(cocoa_scan_names),
    shell:
        """
        {params.slurm} -J {wildcards.cocoa_name} \
            -o {params.output_dir}/tracks/{wildcards.cocoa_name}/slurm_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=tracks \
                network_name={wildcards.cocoa_name} \
                model=transformer_vqvae \
                datamodule=cocoa_tracks \
                datamodule.data_dir={COCOA_DATA_DIR} \
                datamodule.num_events=null \
                model.encoder.model.d_model={cocoa_encoder_size[d_model]} \
                model.encoder.model.n_heads={cocoa_encoder_size[n_heads]} \
                model.encoder.model.num_layers={cocoa_encoder_size[num_layers]} \
                model.encoder.model.dim_feedforward={cocoa_encoder_size[dim_feedforward]} \
                model.decoder.model.d_model={cocoa_encoder_size[d_model]} \
                model.decoder.model.n_heads={cocoa_encoder_size[n_heads]} \
                model.decoder.model.num_layers={cocoa_encoder_size[num_layers]} \
                model.decoder.model.dim_feedforward={cocoa_encoder_size[dim_feedforward]} \
                model.codebook_size={params.codebook_size} \
                model.codebook_dim={params.codebook_dim} \
                model.num_quantizers={params.num_quantizers} \
                model.learning_rate={params.learning_rate} \
                model.optimizer.lr={params.learning_rate} \
                +model.commitment_weight=1.0 \
                trainer.max_epochs=50 \
                trainer.check_val_every_n_epoch=1 \
                trainer.val_check_interval=1.0 \
                trainer.limit_val_batches=1.0 \
                +trainer.num_sanity_val_steps=0 \
                trainer.gradient_clip_val=1.0 \
                trainer.enable_progress_bar=false \
                callbacks=encode_cocoa \
                callbacks.early_stopping.patience=15 \
                callbacks.reconstruction_monitor.log_every_n_epochs=5 \
                +callbacks.reconstruction_monitor.max_batches=100 \
                datamodule.transforms.preprocess.cst_fn.filename={COCOA_CST_FN}"
        """

rule all_cocoa_tracks_test:
    input:
        expand(cocoa_output_dir / "tracks/{cocoa_name}/TEST_SUCCESS.txt", cocoa_name=cocoa_scan_names),

rule test_cocoa_tracks:
