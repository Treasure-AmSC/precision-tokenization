        slurm = SLURM,
    wildcard_constraints:
        cocoa_name = "|".join(cocoa_truthpart_scan_names),
    shell:
        """
        {params.slurm} -J test_{wildcards.cocoa_name} \
            -o {params.output_dir}/truthpart/{wildcards.cocoa_name}/slurm_test_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
