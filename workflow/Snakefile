# ── ROC comparison: cb1024/cb8192 scan points vs existing references ────────
# Compares the full-test-set predictions.npz of the 3 new token_clf_full_{label}
# scan points against the pre-existing token_clf_full_v2 (medium-encoder token
# classifier) and feature_clf_full_v3 (raw-feature baseline) runs. Those two
# reference runs saved their FULL-test-set predictions under test_full/ (their
# test/ holds an earlier, 512k-jet-truncated run) — scripts/compare_roc.py's
# --from_predictions loader checks "{run_dir}/test/test_predictions/predictions.npz"
# then falls back to "{run_dir}/predictions.npz", so pointing run_dir directly at
# the .../test_full/test_predictions folder makes it pick up the right file via
# that fallback.
COMPARE_ROC_SCAN_LABELS = ["cb1024_nq3", "cb1024_nq4", "cb8192_nq4"]
COMPARE_ROC_REFS = {
    "token_clf_full_v2": scan_output_dir / "classifiers/token_clf_full_v2/test_full/test_predictions",
    "feature_clf_full_v3": scan_output_dir / "classifiers/feature_clf_full_v3/test_full/test_predictions",
}
roc_scan_output_dir = scan_output_dir / "roc_comparison_scan"

rule compare_roc_scan:
    input:
        scan_preds = expand(
            scan_output_dir / "classifiers/token_clf_full_{label}/test/test_predictions/predictions.npz",
            label=COMPARE_ROC_SCAN_LABELS,
        ),
        ref_preds = [p / "predictions.npz" for p in COMPARE_ROC_REFS.values()],
    output:
        auc_csv = roc_scan_output_dir / "token_clf_scan_vs_refs_auc.csv",
        btag_roc = roc_scan_output_dir / "token_clf_scan_vs_refs_btag_roc.pdf",
        ovr_roc = roc_scan_output_dir / "token_clf_scan_vs_refs_ovr_roc.pdf",
    params:
        run_dirs = " ".join(
            [str(scan_output_dir / f"classifiers/token_clf_full_{label}") for label in COMPARE_ROC_SCAN_LABELS]
            + [str(p) for p in COMPARE_ROC_REFS.values()]
        ),
        run_labels = " ".join(COMPARE_ROC_SCAN_LABELS + list(COMPARE_ROC_REFS.keys())),
        output_dir = roc_scan_output_dir,
        output_name = "token_clf_scan_vs_refs",
    shell:
        """
        pixi run python scripts/compare_roc.py \
            --from_predictions \
            --run_dirs {params.run_dirs} \
            --run_labels {params.run_labels} \
            --output_dir {params.output_dir} \
            --output_name {params.output_name}
        """

# ══════════════════════════════════════════════════════════════════════════════
# Combined full-dataset FEATURE classifier baseline (from scratch, ~200M jets)
# ══════════════════════════════════════════════════════════════════════════════
# Raw-feature counterpart to token_clf_full: trains a FeatureClassifier FROM SCRATCH on
# the union of the small+medium+large h5 files (~200M jets), streamed + interleaved +
# shuffle-buffered by the new MultiFileIterModule (datamodule=atlas_iterable_multi). Each
# file is split independently with the same seed=42 fractions, so the combined 70/15/15
# split is preserved and the held-out 15% test split is reproducible.
#
# Model size MATCHES token_clf_full: we reuse the exact token_clf_full geometry
# (d_model512/n_heads8/num_layers5/dim_feedforward1024). At that geometry the
# FeatureClassifier is 11,052,036 params vs token_clf_full's VectorClassifier 11,045,892
# (diff 6,144 = 0.06%). NO warm-start (the previous feature_clf 128/8/4/512 weights are
# incompatible and unused) — training starts from random init.
#
# Data: the COMPLETE large h5 (168,495,316 jets) under /sdf/data plus medium+small. The
# /sdf/scratch large copy is TRUNCATED/corrupt and must NOT be used.
#
# IO/STAGING decision: the three files total ~107 GB (large 90 + medium 14 + small 3) and
# /lscratch shows only ~107 GB free (compute-node capacity uncertain, and token_clf_full
# is concurrently using scratch). That is NOT clearly >130 GB, so we do NOT stage to local
# NVMe — we read directly from the shared FS and rely on num_workers=8 (the SLURM alloc
# already requests --cpus-per-task=8). Correctness > speed.

# Reuse token_clf_full's network geometry verbatim so the param count matches.
FEATURE_CLF_FULL_NET = TOKEN_CLF_FULL_NET
# Default training length (overridable via --config feature_clf_full_max_epochs=N).
FEATURE_CLF_FULL_MAX_EPOCHS = config.get("feature_clf_full_max_epochs", 30)
# SLURM with extra CPUs for the streaming dataloader workers (mirrors tokenize_dataset).
FEATURE_CLF_FULL_SLURM = f"sbatch --wait -A {SLURM_ACCOUNT} -p {SLURM_PARTITION} -t 7000 --mem=100G --gres=gpu:1 --cpus-per-task=8 -D {WORKSPACE}"

rule all_feature_classifier_full:
    input:
        scan_output_dir / f"classifiers/feature_clf_full{RUN_SUFFIX}/SUCCESS.txt",

rule all_feature_classifier_full_test:
    input:
        scan_output_dir / "classifiers/feature_clf_full/TEST_SUCCESS.txt",

rule train_feature_classifier_full:
    output:
        scan_output_dir / f"classifiers/feature_clf_full{RUN_SUFFIX}/SUCCESS.txt",
        scan_output_dir / f"classifiers/feature_clf_full{RUN_SUFFIX}/checkpoints/best.ckpt",
    params:
        output_dir = scan_output_dir,
        net_overrides = FEATURE_CLF_FULL_NET,
        max_epochs = FEATURE_CLF_FULL_MAX_EPOCHS,
        name = "feature_clf_full" + RUN_SUFFIX,
        slurm = FEATURE_CLF_FULL_SLURM,
    shell:
        # From scratch (no ckpt/weight warm-start). Stage the 90 GB complete large h5 to
        # local NVMe (/lscratch) for fast random reads, then override data_paths so large
        # is read from $LOCAL and medium+small (~17 GB) stream from the shared FS.
        # HDF5_USE_FILE_LOCKING=FALSE: the medium/small h5 live on shared /sdf/scratch, and
        # HDF5's read lock can abort() (SIGABRT) when many workers open them concurrently
        # (train + validation). Reads are read-only, so disabling the lock is safe.
        """
        {params.slurm} -J {params.name} \
            -o {params.output_dir}/classifiers/{params.name}/slurm_%j.log \
            --wrap='
                export HDF5_USE_FILE_LOCKING=FALSE && \
                LOCAL=/lscratch/{params.name}_$$ && mkdir -p $LOCAL && \
                trap "rm -rf $LOCAL" EXIT && \
                echo "Staging large h5 to $LOCAL ..." && \
                cp /sdf/data/atlas/u/jkrupa/mc-flavtag-ttbar-large.h5 $LOCAL/ && \
                pixi run python scripts/train.py \
                    output_dir={params.output_dir} \
                    project_name=classifiers \
                    network_name={params.name} \
                    datamodule=atlas_iterable_multi \
                    datamodule.data_paths=[$LOCAL/mc-flavtag-ttbar-large.h5,/sdf/scratch/users/j/jkrupa/data/atlas/mc-flavtag-ttbar-medium.h5,/sdf/scratch/users/j/jkrupa/data/atlas/mc-flavtag-ttbar-small.h5] \
                    datamodule.num_workers=8 \
                    datamodule.num_csts=40 \
                    model=feature_classifier \
                    {params.net_overrides} \
                    trainer.max_epochs={params.max_epochs} \
                    trainer.gradient_clip_val=5.0 \
                    model.scheduler.total_steps=$((136529 * {params.max_epochs})) \
                    +trainer.num_sanity_val_steps=0 \
                    trainer.enable_progress_bar=false \
                    callbacks=classify \
                    datamodule.transforms.preprocess.jet_fn.filename=/sdf/data/atlas/u/jkrupa/heptokens/resources/jet_quantiles.joblib \
                    datamodule.transforms.preprocess.cst_fn.filename=/sdf/data/atlas/u/jkrupa/heptokens/resources/cst_quantiles.joblib'
        """

rule test_feature_classifier_full:
    input:
        success = scan_output_dir / "classifiers/feature_clf_full/SUCCESS.txt",
        ckpt = scan_output_dir / "classifiers/feature_clf_full/checkpoints/best.ckpt",
    output:
        scan_output_dir / "classifiers/feature_clf_full/TEST_SUCCESS.txt",
    params:
        output_dir = scan_output_dir,
        net_overrides = FEATURE_CLF_FULL_NET,
        slurm = FEATURE_CLF_FULL_SLURM,
    shell:
        # test_only=true: evaluate the held-out 15% combined test split (same data_paths,
        # seed=42 + fractions => the held-out portion across all three files). Stage the
        # large h5 to local NVMe for fast reads, same as the train rule.
        """
        {params.slurm} -J test_feature_clf_full \
            -o {params.output_dir}/classifiers/feature_clf_full/slurm_test_%j.log \
            --wrap='
                LOCAL=/lscratch/test_feature_clf_full_$$ && mkdir -p $LOCAL && \
                trap "rm -rf $LOCAL" EXIT && \
                echo "Staging large h5 to $LOCAL ..." && \
                cp /sdf/data/atlas/u/jkrupa/mc-flavtag-ttbar-large.h5 $LOCAL/ && \
                pixi run python scripts/train.py \
                    output_dir={params.output_dir} \
                    project_name=classifiers \
                    network_name=feature_clf_full/test \
                    datamodule=atlas_iterable_multi \
                    datamodule.data_paths=[$LOCAL/mc-flavtag-ttbar-large.h5,/sdf/scratch/users/j/jkrupa/data/atlas/mc-flavtag-ttbar-medium.h5,/sdf/scratch/users/j/jkrupa/data/atlas/mc-flavtag-ttbar-small.h5] \
                    datamodule.num_workers=8 \
                    datamodule.num_csts=40 \
                    model=feature_classifier \
                    {params.net_overrides} \
                    ckpt_path={input.ckpt} \
                    test_only=true \
                    callbacks=classify \
                    trainer.enable_progress_bar=false \
                    datamodule.transforms.preprocess.jet_fn.filename=/sdf/data/atlas/u/jkrupa/heptokens/resources/jet_quantiles.joblib \
                    datamodule.transforms.preprocess.cst_fn.filename=/sdf/data/atlas/u/jkrupa/heptokens/resources/cst_quantiles.joblib'
        """

# ── Hybrid VQ-VAE (MLP encoder + Transformer decoder) ────────────────────────
