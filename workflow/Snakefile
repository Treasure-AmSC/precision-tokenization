                model.encoder.model.n_heads={cocoa_encoder_size[n_heads]} \
                model.encoder.model.num_layers={cocoa_encoder_size[num_layers]} \
                model.encoder.model.dim_feedforward={cocoa_encoder_size[dim_feedforward]} \
                model.decoder.model.d_model={cocoa_encoder_size[d_model]} \
                model.decoder.model.n_heads={cocoa_encoder_size[n_heads]} \
                model.decoder.model.num_layers={cocoa_encoder_size[num_layers]} \
                model.decoder.model.dim_feedforward={cocoa_encoder_size[dim_feedforward]} \
