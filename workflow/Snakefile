# ══════════════════════════════════════════════════════════════════════════════
# COCOA 10M-event hyperparameter re-scan (tracks & topos, nq={3,4} only)
# ══════════════════════════════════════════════════════════════════════════════
# Same cb/cd grid as the main cocoa_scan above, but:
#   - num_events FIXED at 10,000,000 for both modalities (matches the JetSet
#     ttbar scan_n_jets=10_000_000 point already in the vqvae_scan grid, and
#     matches results/cocoa_scan/{tracks,topos}_datascan/*_n10000000).
#   - nq restricted to {3,4} (dropping nq=2).
# Everything else (architecture, trainer, callbacks, cst_fn) is byte-for-byte
# identical to train_cocoa_tracks/train_cocoa_topos above. Separate output dirs
# (tracks_10M/, topos_10M/) so this does not collide with the existing
# full-dataset (tracks) / 5M-capped (topos) results.
cocoa_10M_num_quantizers = [3, 4]
cocoa_10M_num_events = 10_000_000

cocoa_tracks_10M_configs = []
for cb, cd, nq, lr in product(
    cocoa_codebook_sizes, cocoa_codebook_dims, cocoa_10M_num_quantizers, cocoa_learning_rates,
):
    name = f"cocoa_tracks_10M_cb{cb}_cd{cd}_nq{nq}_lr{lr}"
    cocoa_tracks_10M_configs.append({"cb": cb, "cd": cd, "nq": nq, "lr": lr, "name": name})

cocoa_tracks_10M_names = [c["name"] for c in cocoa_tracks_10M_configs]
cocoa_tracks_10M_lookup = {c["name"]: c for c in cocoa_tracks_10M_configs}

cocoa_topos_10M_configs = []
for cb, cd, nq, lr in product(
    cocoa_codebook_sizes, cocoa_topo_codebook_dims, cocoa_10M_num_quantizers, cocoa_learning_rates,
):
    name = f"cocoa_topos_10M_cb{cb}_cd{cd}_nq{nq}_lr{lr}"
    cocoa_topos_10M_configs.append({"cb": cb, "cd": cd, "nq": nq, "lr": lr, "name": name})

cocoa_topos_10M_names = [c["name"] for c in cocoa_topos_10M_configs]
cocoa_topos_10M_lookup = {c["name"]: c for c in cocoa_topos_10M_configs}

rule all_cocoa_tracks_10M:
    input:
        expand(cocoa_output_dir / "tracks_10M/{cocoa_name}/SUCCESS.txt", cocoa_name=cocoa_tracks_10M_names),

rule train_cocoa_tracks_10M:
    output:
        cocoa_output_dir / "tracks_10M/{cocoa_name}/SUCCESS.txt",
        ckpt = cocoa_output_dir / "tracks_10M/{cocoa_name}/checkpoints/best.ckpt",
    params:
        output_dir = cocoa_output_dir,
        codebook_size = lambda wc: cocoa_tracks_10M_lookup[wc.cocoa_name]["cb"],
        codebook_dim = lambda wc: cocoa_tracks_10M_lookup[wc.cocoa_name]["cd"],
        num_quantizers = lambda wc: cocoa_tracks_10M_lookup[wc.cocoa_name]["nq"],
        learning_rate = lambda wc: cocoa_tracks_10M_lookup[wc.cocoa_name]["lr"],
        slurm = SLURM,
    wildcard_constraints:
        cocoa_name = "|".join(cocoa_tracks_10M_names),
    shell:
        """
        {params.slurm} -J {wildcards.cocoa_name} \
            -o {params.output_dir}/tracks_10M/{wildcards.cocoa_name}/slurm_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=tracks_10M \
                network_name={wildcards.cocoa_name} \
                model=transformer_vqvae \
                datamodule=cocoa_tracks \
                datamodule.data_dir={COCOA_DATA_DIR} \
                datamodule.num_events={cocoa_10M_num_events} \
                model.encoder.model.d_model={cocoa_encoder_size[d_model]} \
                model.encoder.model.n_heads={cocoa_encoder_size[n_heads]} \
                model.encoder.model.num_layers={cocoa_encoder_size[num_layers]} \
                model.encoder.model.dim_feedforward={cocoa_encoder_size[dim_feedforward]} \
                model.decoder.model.d_model={cocoa_encoder_size[d_model]} \
                model.decoder.model.n_heads={cocoa_encoder_size[n_heads]} \
                model.decoder.model.num_layers={cocoa_encoder_size[num_layers]} \
                model.decoder.model.dim_feedforward={cocoa_encoder_size[dim_feedforward]} \
                model.codebook_size={params.codebook_size} \
                model.codebook_dim={params.codebook_dim} \
                model.num_quantizers={params.num_quantizers} \
                model.learning_rate={params.learning_rate} \
                model.optimizer.lr={params.learning_rate} \
                +model.commitment_weight=1.0 \
                trainer.max_epochs=50 \
                trainer.check_val_every_n_epoch=1 \
                trainer.val_check_interval=1.0 \
                trainer.limit_val_batches=1.0 \
                +trainer.num_sanity_val_steps=0 \
                trainer.gradient_clip_val=1.0 \
                trainer.enable_progress_bar=false \
                callbacks=encode_cocoa \
                callbacks.early_stopping.patience=15 \
                callbacks.reconstruction_monitor.log_every_n_epochs=5 \
                +callbacks.reconstruction_monitor.max_batches=100 \
                datamodule.transforms.preprocess.cst_fn.filename={COCOA_CST_FN}"
        """

