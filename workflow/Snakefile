                +callbacks.reconstruction_monitor.energy_idx=3 \
                +callbacks.reconstruction_monitor.max_batches=100 \
                trainer.limit_val_batches=100 \
                trainer.enable_progress_bar=false \
                datamodule.transforms.preprocess.cst_fn.filename={COCOA_TRUTHPART_CST_FN}"
        """

# ══════════════════════════════════════════════════════════════════════════════
# COCOA dataset-size scan (tracks & topos)
# ══════════════════════════════════════════════════════════════════════════════
# The main cocoa_scan grid above trains tracks with num_events=null (all ~20M
# events in train_topup2_20M_cells256) but topos/truthpart capped at 5M — i.e.
# every modality used one FIXED training-set size, never swept. This section
# fixes the VQ hyperparameters at one representative operating point per
# modality and sweeps datamodule.num_events to find where reconstruction
# quality saturates with dataset size. Max available is ~19.98M events (200
# files) in train_topup2_20M_cells256.
cocoa_datascan_sizes = [1_000_000, 5_000_000, 10_000_000]
cocoa_datascan_op_points = {
    "tracks": {"cb": 4096, "cd": 4, "nq": 4, "lr": 0.001},
    "topos":  {"cb": 4096, "cd": 8, "nq": 4, "lr": 0.001},
}

cocoa_datascan_configs = []
for modality, op in cocoa_datascan_op_points.items():
    for n in cocoa_datascan_sizes:
        name = f"cocoa_{modality}_datascan_n{n}"
        cocoa_datascan_configs.append({**op, "n": n, "modality": modality, "name": name})

cocoa_datascan_names = {
    modality: [c["name"] for c in cocoa_datascan_configs if c["modality"] == modality]
    for modality in cocoa_datascan_op_points
}
cocoa_datascan_lookup = {c["name"]: c for c in cocoa_datascan_configs}

rule all_cocoa_datascan:
    input:
        expand(cocoa_output_dir / "tracks_datascan/{cocoa_name}/SUCCESS.txt", cocoa_name=cocoa_datascan_names["tracks"]),
        expand(cocoa_output_dir / "topos_datascan/{cocoa_name}/SUCCESS.txt", cocoa_name=cocoa_datascan_names["topos"]),

rule train_cocoa_tracks_datascan:
    output:
        cocoa_output_dir / "tracks_datascan/{cocoa_name}/SUCCESS.txt",
        ckpt = cocoa_output_dir / "tracks_datascan/{cocoa_name}/checkpoints/best.ckpt",
    params:
        output_dir = cocoa_output_dir,
        codebook_size = lambda wc: cocoa_datascan_lookup[wc.cocoa_name]["cb"],
        codebook_dim = lambda wc: cocoa_datascan_lookup[wc.cocoa_name]["cd"],
        num_quantizers = lambda wc: cocoa_datascan_lookup[wc.cocoa_name]["nq"],
        learning_rate = lambda wc: cocoa_datascan_lookup[wc.cocoa_name]["lr"],
        num_events = lambda wc: cocoa_datascan_lookup[wc.cocoa_name]["n"],
        slurm = SLURM,
    wildcard_constraints:
        cocoa_name = "|".join(cocoa_datascan_names["tracks"]),
    shell:
        """
        {params.slurm} -J {wildcards.cocoa_name} \
            -o {params.output_dir}/tracks_datascan/{wildcards.cocoa_name}/slurm_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=tracks_datascan \
                network_name={wildcards.cocoa_name} \
                model=transformer_vqvae \
                datamodule=cocoa_tracks \
                datamodule.data_dir={COCOA_DATA_DIR} \
                datamodule.num_events={params.num_events} \
                model.encoder.model.d_model={cocoa_encoder_size[d_model]} \
                model.encoder.model.n_heads={cocoa_encoder_size[n_heads]} \
                model.encoder.model.num_layers={cocoa_encoder_size[num_layers]} \
                model.encoder.model.dim_feedforward={cocoa_encoder_size[dim_feedforward]} \
                model.decoder.model.d_model={cocoa_encoder_size[d_model]} \
                model.decoder.model.n_heads={cocoa_encoder_size[n_heads]} \
                model.decoder.model.num_layers={cocoa_encoder_size[num_layers]} \
                model.decoder.model.dim_feedforward={cocoa_encoder_size[dim_feedforward]} \
                model.codebook_size={params.codebook_size} \
                model.codebook_dim={params.codebook_dim} \
                model.num_quantizers={params.num_quantizers} \
                model.learning_rate={params.learning_rate} \
                model.optimizer.lr={params.learning_rate} \
                +model.commitment_weight=1.0 \
                trainer.max_epochs=50 \
                trainer.check_val_every_n_epoch=1 \
                trainer.val_check_interval=1.0 \
                trainer.limit_val_batches=1.0 \
                +trainer.num_sanity_val_steps=0 \
                trainer.gradient_clip_val=1.0 \
                trainer.enable_progress_bar=false \
                callbacks=encode_cocoa \
                callbacks.early_stopping.patience=15 \
                callbacks.reconstruction_monitor.log_every_n_epochs=5 \
                +callbacks.reconstruction_monitor.max_batches=100 \
                datamodule.transforms.preprocess.cst_fn.filename={COCOA_CST_FN}"
        """

rule all_cocoa_tracks_datascan_test:
    input:
        expand(cocoa_output_dir / "tracks_datascan/{cocoa_name}/TEST_SUCCESS.txt", cocoa_name=cocoa_datascan_names["tracks"]),

