"""Snakemake workflow for training and evaluating tokenizers."""
from pathlib import Path
from itertools import product

# ── Paths ─────────────────────────────────────────────────────────────────────
WORKSPACE       = Path("/sdf/data/atlas/u/jkrupa/heptokens")
output_dir      = WORKSPACE / "results" / "long_run"
scan_output_dir = WORKSPACE / "results" / "vqvae_scan"

# ── SLURM settings ───────────────────────────────────────────────────────────
# Set your account (and GPU partition), e.g.:
#   --config slurm_account=my_account slurm_partition=gpu
SLURM_ACCOUNT = config.get("slurm_account", "<your_account>")
SLURM_PARTITION = config.get("slurm_partition", "ampere")
SLURM = f"sbatch --wait -A {SLURM_ACCOUNT} -p {SLURM_PARTITION} -t 7000 --mem=100G --gres=gpu:1 -D {WORKSPACE}"

# ── Configurable suffix for ablation runs ─────────────────────────────────────
# Usage: snakemake all_vqvae_scan --config suffix=_onlyptetaphi cst_features='[pt,deta,dphi]'
SUFFIX = config.get("suffix", "")

# Optional: restrict constituent features (applied to both train and test)
# Pass as: --config cst_features='[pt,deta,dphi]'
_cst_feat_cfg = config.get("cst_features", "")
CST_FEATURES_OVERRIDE = f"'datamodule.cst_features={_cst_feat_cfg}'" if _cst_feat_cfg else ""

# ── General parameters ────────────────────────────────────────────────────────
n_jets =  [10_000_000]
tokenizers = ["transformer_vqvae"]

# ── Architecture sizes per model type ─────────────────────────────────────────
# MLP encoder/decoder (vqvae)
mlp_sizes = {
    "small":  "[64,128]",
    "medium": "[128,256,512]", #default
    "large":  "[256,512,1024]",
}

# Transformer encoder/decoder (transformer_vqvae)
transformer_sizes = {
    "small":  {"d_model": 64,  "n_heads": 4, "num_layers": 2, "dim_feedforward": 256},
    "medium": {"d_model": 128, "n_heads": 8, "num_layers": 4, "dim_feedforward": 512}, #default
    "large":  {"d_model": 256, "n_heads": 8, "num_layers": 6, "dim_feedforward": 1024},
}

arch_sizes = {
    "vqvae":             mlp_sizes,
    "transformer_vqvae": transformer_sizes,
}

# ── Model-type naming + learning rate (kept consistent with existing results) ─
# Existing MLP runs are named bare `enc_<size>_...` at lr=1e-3; Transformer runs
# are `transformer_vqvae_enc_<size>_...` at lr=3e-4 (verified against results/ and
# scripts/compare_models.py). Preserve both conventions exactly so new runs sit
# alongside — and are reused/compared with — the existing scan.
model_prefix = {"vqvae": "", "transformer_vqvae": "transformer_vqvae_"}
model_lr     = {"vqvae": 0.001, "transformer_vqvae": 0.0003}

# ── Size × #training-events grid at the optimal RVQ operating point ───────────
# Fixed VQ params = jet-resolution optimum (verified rank 1/30 over the transformer
# grid): codebook_size=32768, codebook_dim=8, num_quantizers=4, commitment=1.0.
# 2D scan over model size {small,medium,large} × training events {1M,10M,20M} for
# both MLP (vqvae) and Transformer (transformer_vqvae) encoders = 18 configs; the
# 4 already-trained transformer points are skipped via their existing SUCCESS.txt.
SCAN_CB, SCAN_CD, SCAN_NQ, SCAN_CW = 32768, 8, 4, 1.0
scan_sizes  = ["small", "medium", "large"]
scan_n_jets = [1_000_000, 10_000_000, 20_000_000]
scan_models = ["vqvae", "transformer_vqvae"]

scan_configs = []
for model in scan_models:
    lr = model_lr[model]
    for enc in scan_sizes:
        for nj in scan_n_jets:
            name = (
                f"{model_prefix[model]}enc_{enc}"
                f"_cb{SCAN_CB}_cd{SCAN_CD}_nq{SCAN_NQ}"
                f"_lr{lr}_cw{SCAN_CW}_nj{nj}{SUFFIX}"
            )
            scan_configs.append({
                "model": model, "enc": enc, "cb": SCAN_CB, "cd": SCAN_CD,
                "nq": SCAN_NQ, "lr": lr, "cw": SCAN_CW, "nj": nj, "name": name,
            })

# No filter needed — train_tokenizer creates new runs, test_tokenizer depends on SUCCESS.txt
scan_names = [c["name"] for c in scan_configs]
scan_lookup = {c["name"]: c for c in scan_configs}

def _arch_overrides(wc):
    """Return encoder/decoder arch overrides appropriate for each model type."""
    cfg = scan_lookup[wc.scan_name]
    model = cfg["model"]
    enc = cfg["enc"]
    if model == "vqvae":
        dims = mlp_sizes[enc]
        return f"'model.encoder.model.hidden_dims={dims}' 'model.decoder.model.hidden_dims={dims}'"
    if model == "transformer_vqvae":
        t = transformer_sizes[enc]
        parts = []
        for side in ("encoder", "decoder"):
            for k, v in t.items():
                parts.append(f"model.{side}.model.{k}={v}")
        return " ".join(parts)
    return ""

# ── Top-level targets ────────────────────────────────────────────────────────
rule all:
    input:
        expand(output_dir / "{tokenizer}/n_jets_{num_jets}/SUCCESS.txt", tokenizer=tokenizers, num_jets=n_jets),
        #expand(output_dir / "classifier/feature_cf_{num_jets}/SUCCESS.txt", num_jets=n_jets),
        #expand(output_dir / "classifier/{tokenizer}_cf_{num_jets}/SUCCESS.txt", tokenizer=tokenizers, num_jets=n_jets),

rule all_vqvae_scan:
    input:
        expand(scan_output_dir / "vqvae_scan/{scan_name}/SUCCESS.txt", scan_name=scan_names),

rule all_vqvae_test:
    input:
        expand(scan_output_dir / "vqvae_scan/{scan_name}/TEST_SUCCESS.txt", scan_name=scan_names),

# ── VQ-VAE hyperparameter scan rule ──────────────────────────────────────────
# Constrain scan_name to only match entries in the current scan grid
wildcard_constraints:
    scan_name = "|".join(scan_names),

rule train_tokenizer:
    output:
        scan_output_dir / "vqvae_scan/{scan_name}/SUCCESS.txt",
        ckpt = scan_output_dir / "vqvae_scan/{scan_name}/checkpoints/best.ckpt",
    params:
        output_dir = scan_output_dir,
        model = lambda wc: scan_lookup[wc.scan_name]["model"],
        arch_overrides = _arch_overrides,
        codebook_size = lambda wc: scan_lookup[wc.scan_name]["cb"],
        codebook_dim = lambda wc: scan_lookup[wc.scan_name]["cd"],
        num_quantizers = lambda wc: scan_lookup[wc.scan_name]["nq"],
        learning_rate = lambda wc: scan_lookup[wc.scan_name]["lr"],
        commitment_weight = lambda wc: scan_lookup[wc.scan_name]["cw"],
        n_jets = lambda wc: scan_lookup[wc.scan_name]["nj"],
        slurm = SLURM,
    shell:
        """
        {params.slurm} -J {wildcards.scan_name} \
            -o {params.output_dir}/vqvae_scan/{wildcards.scan_name}/slurm_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=vqvae_scan \
                network_name={wildcards.scan_name} \
                model={params.model} \
                datamodule=atlas_mappable \
                datamodule.num_jets={params.n_jets} \
                {params.arch_overrides} \
                model.codebook_size={params.codebook_size} \
                model.codebook_dim={params.codebook_dim} \
                model.num_quantizers={params.num_quantizers} \
                model.learning_rate={params.learning_rate} \
                model.optimizer.lr={params.learning_rate} \
                +model.commitment_weight={params.commitment_weight} \
                trainer.max_epochs=200 \
                trainer.check_val_every_n_epoch=1 \
                trainer.val_check_interval=1.0 \
                trainer.limit_val_batches=1.0 \
                +trainer.num_sanity_val_steps=0 \
                trainer.gradient_clip_val=1.0 \
                trainer.enable_progress_bar=false \
                callbacks=encode \
                callbacks.reconstruction_monitor.log_every_n_epochs=5 \
                +callbacks.reconstruction_monitor.max_batches=100 \
                datamodule.transforms.preprocess.jet_fn.filename='/sdf/data/atlas/u/jkrupa/heptokens/resources/jet_quantiles.joblib' \
                datamodule.transforms.preprocess.cst_fn.filename='/sdf/data/atlas/u/jkrupa/heptokens/resources/cst_quantiles.joblib' \
                {CST_FEATURES_OVERRIDE}"
        """

# ── VQ-VAE test evaluation rule ──────────────────────────────────────────────
rule test_tokenizer:
    input:
        success = scan_output_dir / "vqvae_scan/{scan_name}/SUCCESS.txt",
        ckpt = scan_output_dir / "vqvae_scan/{scan_name}/checkpoints/best.ckpt",
    output:
        scan_output_dir / "vqvae_scan/{scan_name}/TEST_SUCCESS.txt",
    params:
        output_dir = scan_output_dir,
        model = lambda wc: scan_lookup[wc.scan_name]["model"],
        arch_overrides = _arch_overrides,
        codebook_size = lambda wc: scan_lookup[wc.scan_name]["cb"],
        codebook_dim = lambda wc: scan_lookup[wc.scan_name]["cd"],
        num_quantizers = lambda wc: scan_lookup[wc.scan_name]["nq"],
        learning_rate = lambda wc: scan_lookup[wc.scan_name]["lr"],
        commitment_weight = lambda wc: scan_lookup[wc.scan_name]["cw"],
        n_jets = lambda wc: scan_lookup[wc.scan_name]["nj"],
        slurm = SLURM,
    shell:
        """
        {params.slurm} -J test_{wildcards.scan_name} \
            -o {params.output_dir}/vqvae_scan/{wildcards.scan_name}/slurm_test_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=vqvae_scan \
                network_name={wildcards.scan_name}/test \
                model={params.model} \
                datamodule=atlas_iterable \
                datamodule.data_path=/sdf/scratch/users/j/jkrupa/data/atlas/mc-flavtag-ttbar-small.h5 \
                datamodule.train_frac=0.001 \
                datamodule.num_workers=0 \
                datamodule.val_frac=0.001 \
                datamodule.test_frac=0.998 \
                datamodule.num_workers=2 \
                datamodule.num_csts=40 \
                ckpt_path={input.ckpt} \
                test_only=true \
                {params.arch_overrides} \
                model.codebook_size={params.codebook_size} \
                model.codebook_dim={params.codebook_dim} \
                model.num_quantizers={params.num_quantizers} \
                model.learning_rate={params.learning_rate} \
                +model.commitment_weight={params.commitment_weight} \
                callbacks=encode \
                +callbacks.reconstruction_monitor.max_batches=100 \
                trainer.limit_val_batches=100 \
                trainer.enable_progress_bar=false \
                datamodule.transforms.preprocess.jet_fn.filename='/sdf/data/atlas/u/jkrupa/heptokens/resources/jet_quantiles.joblib' \
                datamodule.transforms.preprocess.cst_fn.filename='/sdf/data/atlas/u/jkrupa/heptokens/resources/cst_quantiles.joblib' \
                {CST_FEATURES_OVERRIDE}"
        """

# ── Classifier configuration ──────────────────────────────────────────────────
# Classifier network size (shared by token and feature classifiers)
clf_network = {
    "d_model": 128,
    "n_heads": 8,
    "num_layers": 4,
    "dim_feedforward": 512,
}

# Tokenizer scan points to classify (must already be trained)
clf_tokenizer_points = [
    {"scan_name": "transformer_vqvae_enc_medium_cb512_cd8_nq3_lr0.001_cw1.0_nj10000000",
     "cb": 512, "cd": 8, "nq": 3},
    {"scan_name": "transformer_vqvae_enc_large_cb32768_cd8_nq4_lr0.0003_cw1.0_nj10000000",
     "cb": 32768, "cd": 8, "nq": 4},
]

clf_names = [p["scan_name"] for p in clf_tokenizer_points]
clf_lookup = {p["scan_name"]: p for p in clf_tokenizer_points}

def _clf_net_overrides():
    """Classifier network Hydra overrides."""
    return " ".join(f"model.{k}={v}" for k, v in clf_network.items())

# ── Classifier targets ────────────────────────────────────────────────────────
rule all_classifiers:
    input:
        # Feature baseline
        scan_output_dir / "classifiers/feature_clf/SUCCESS.txt",
        # Vector classifiers (z_q) for each scan point
        expand(scan_output_dir / "classifiers/vector_clf_{clf_name}/SUCCESS.txt",
               clf_name=clf_names),

rule train_feature_classifier:
    output:
        scan_output_dir / "classifiers/feature_clf/SUCCESS.txt",
        scan_output_dir / "classifiers/feature_clf/checkpoints/best.ckpt",
    params:
        output_dir = scan_output_dir,
        net_overrides = _clf_net_overrides(),
        slurm = SLURM,
    shell:
        """
        {params.slurm} -J feature_clf \
            -o {params.output_dir}/classifiers/feature_clf/slurm_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=classifiers \
                network_name=feature_clf \
                datamodule=atlas_mappable \
                datamodule.num_jets=10000000 \
                model=feature_classifier \
                {params.net_overrides} \
                trainer.max_epochs=30 \
                +trainer.num_sanity_val_steps=0 \
                trainer.enable_progress_bar=false \
                callbacks=classify \
                datamodule.transforms.preprocess.jet_fn.filename='/sdf/data/atlas/u/jkrupa/heptokens/resources/jet_quantiles.joblib' \
                datamodule.transforms.preprocess.cst_fn.filename='/sdf/data/atlas/u/jkrupa/heptokens/resources/cst_quantiles.joblib'"
        """

rule train_vector_classifier:
    input:
        tokenizer_ckpt = ancient(scan_output_dir / "vqvae_scan/{clf_name}/checkpoints/best.ckpt"),
    output:
        scan_output_dir / "classifiers/vector_clf_{clf_name}/SUCCESS.txt",
        scan_output_dir / "classifiers/vector_clf_{clf_name}/checkpoints/best.ckpt",
    params:
        output_dir = scan_output_dir,
        codebook_dim = lambda wc: clf_lookup[wc.clf_name]["cd"],
        net_overrides = _clf_net_overrides(),
        slurm = SLURM,
    shell:
        """
        {params.slurm} -J vector_clf_{wildcards.clf_name} \
            -o {params.output_dir}/classifiers/vector_clf_{wildcards.clf_name}/slurm_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=classifiers \
                network_name=vector_clf_{wildcards.clf_name} \
                datamodule=atlas_mappable \
                datamodule.num_jets=10000000 \
                model=vector_classifier \
                model.tokenizer_ckpt={input.tokenizer_ckpt} \
                model.codebook_dim={params.codebook_dim} \
                {params.net_overrides} \
                trainer.max_epochs=30 \
                +trainer.num_sanity_val_steps=0 \
                trainer.enable_progress_bar=false \
                callbacks=classify \
                datamodule.transforms.preprocess.jet_fn.filename='/sdf/data/atlas/u/jkrupa/heptokens/resources/jet_quantiles.joblib' \
                datamodule.transforms.preprocess.cst_fn.filename='/sdf/data/atlas/u/jkrupa/heptokens/resources/cst_quantiles.joblib'"
        """

# ── Classifier test targets ──────────────────────────────────────────────────
rule all_classifier_tests:
    input:
        scan_output_dir / "classifiers/feature_clf/TEST_SUCCESS.txt",
        expand(scan_output_dir / "classifiers/vector_clf_{clf_name}/TEST_SUCCESS.txt",
               clf_name=clf_names),

rule test_feature_classifier:
    input:
        success = scan_output_dir / "classifiers/feature_clf/SUCCESS.txt",
        ckpt = scan_output_dir / "classifiers/feature_clf/checkpoints/best.ckpt",
    output:
        scan_output_dir / "classifiers/feature_clf/TEST_SUCCESS.txt",
    params:
        output_dir = scan_output_dir,
        net_overrides = _clf_net_overrides(),
        slurm = SLURM,
    shell:
        """
        {params.slurm} -J test_feature_clf \
            -o {params.output_dir}/classifiers/feature_clf/slurm_test_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=classifiers \
                network_name=feature_clf/test \
                datamodule=atlas_iterable \
                datamodule.data_path=/sdf/scratch/users/j/jkrupa/data/atlas/mc-flavtag-ttbar-small.h5 \
                datamodule.train_frac=0.001 \
                datamodule.val_frac=0.001 \
                datamodule.test_frac=0.998 \
                datamodule.num_workers=2 \
                datamodule.num_csts=40 \
                model=feature_classifier \
                {params.net_overrides} \
                ckpt_path={input.ckpt} \
                test_only=true \
                callbacks=classify \
                trainer.enable_progress_bar=false \
                datamodule.transforms.preprocess.jet_fn.filename='/sdf/data/atlas/u/jkrupa/heptokens/resources/jet_quantiles.joblib' \
                datamodule.transforms.preprocess.cst_fn.filename='/sdf/data/atlas/u/jkrupa/heptokens/resources/cst_quantiles.joblib'"
        """

rule test_vector_classifier:
    input:
        success = scan_output_dir / "classifiers/vector_clf_{clf_name}/SUCCESS.txt",
        ckpt = scan_output_dir / "classifiers/vector_clf_{clf_name}/checkpoints/best.ckpt",
        tokenizer_ckpt = ancient(scan_output_dir / "vqvae_scan/{clf_name}/checkpoints/best.ckpt"),
    output:
        scan_output_dir / "classifiers/vector_clf_{clf_name}/TEST_SUCCESS.txt",
    params:
        output_dir = scan_output_dir,
        codebook_dim = lambda wc: clf_lookup[wc.clf_name]["cd"],
        net_overrides = _clf_net_overrides(),
        slurm = SLURM,
    shell:
        """
        {params.slurm} -J test_vector_clf_{wildcards.clf_name} \
            -o {params.output_dir}/classifiers/vector_clf_{wildcards.clf_name}/slurm_test_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=classifiers \
                network_name=vector_clf_{wildcards.clf_name}/test \
                datamodule=atlas_iterable \
                datamodule.data_path=/sdf/scratch/users/j/jkrupa/data/atlas/mc-flavtag-ttbar-small.h5 \
                datamodule.train_frac=0.001 \
                datamodule.val_frac=0.001 \
                datamodule.test_frac=0.998 \
                datamodule.num_workers=2 \
                datamodule.num_csts=40 \
                model=vector_classifier \
                model.tokenizer_ckpt={input.tokenizer_ckpt} \
                model.codebook_dim={params.codebook_dim} \
                {params.net_overrides} \
                ckpt_path={input.ckpt} \
                test_only=true \
                callbacks=classify \
                trainer.enable_progress_bar=false \
                datamodule.transforms.preprocess.jet_fn.filename='/sdf/data/atlas/u/jkrupa/heptokens/resources/jet_quantiles.joblib' \
                datamodule.transforms.preprocess.cst_fn.filename='/sdf/data/atlas/u/jkrupa/heptokens/resources/cst_quantiles.joblib'"
        """

# ══════════════════════════════════════════════════════════════════════════════
# Token-based classifier (VectorClassifier trained directly on pre-exported tokens)
# ══════════════════════════════════════════════════════════════════════════════
# Trains VectorClassifier on the z_q reconstructed from pre-exported VQ-VAE tokens
# (scripts/export_tokens.py). Unlike train_vector_classifier (which re-tokenizes raw
# csts on the fly from atlas_mappable), this reads the .npz tokens directly via the
# token_npz datamodule with model.tokenizer_ckpt=null — enabling training on the full
# ~168M-jet "large" set without re-running the VQ-VAE encoder every epoch.
TOKEN_NPZ_DIR = "/fs/ddn/sdf/group/atlas/d/jkrupa/heptokens/transformer_vqvae_enc_large_cb32768_cd8_nq4_lr0.0003_cw1.0_nj10000000"

# size -> exported token .npz used for token-based classifier training
token_clf_sizes = {
    "large":  f"{TOKEN_NPZ_DIR}/mc-flavtag-ttbar-large.npz",
    "medium": f"{TOKEN_NPZ_DIR}/mc-flavtag-ttbar-medium.npz",
    "small":  f"{TOKEN_NPZ_DIR}/mc-flavtag-ttbar-small.npz",
}
# codebook_dim of the exported tokens (must match the tokenizer used at export time)
TOKEN_CLF_CODEBOOK_DIM = 8
# Default training length for the token classifier (overridable via --config)
TOKEN_CLF_MAX_EPOCHS = config.get("token_clf_max_epochs", 30)

rule all_token_classifiers:
    input:
        scan_output_dir / "classifiers/token_clf_large/SUCCESS.txt",

rule all_token_classifier_tests:
    input:
        scan_output_dir / "classifiers/token_clf_large/TEST_SUCCESS.txt",

# ── Extract mmap'd .npy sidecars once (bounded RAM; needed for the large .npz) ──
rule extract_token_sidecars:
    output:
        marker = TOKEN_NPZ_DIR + "/mc-flavtag-ttbar-{size}_npy/EXTRACT_SUCCESS.txt",
    params:
        npz = lambda wc: token_clf_sizes[wc.size],
        # Streaming extraction is RAM-light (~hundreds of MB); disk is the constraint
        # (the large indices sidecar is ~54 GB), so request modest memory and short time.
        slurm = f"sbatch --wait -A {SLURM_ACCOUNT} -p {SLURM_PARTITION} -t 2000 --mem=16G --gres=gpu:1 -D {WORKSPACE}",
    wildcard_constraints:
        size = "|".join(token_clf_sizes),
    shell:
        """
        {params.slurm} -J extract_{wildcards.size} \
            -o """ + TOKEN_NPZ_DIR + """/extract_{wildcards.size}_%j.log \
            --wrap="pixi run python scripts/extract_token_sidecars.py {params.npz} \
                && touch {output.marker}"
        """

rule train_token_classifier:
    input:
        sidecar = TOKEN_NPZ_DIR + "/mc-flavtag-ttbar-{size}_npy/EXTRACT_SUCCESS.txt",
    output:
        scan_output_dir / "classifiers/token_clf_{size}/SUCCESS.txt",
        scan_output_dir / "classifiers/token_clf_{size}/checkpoints/best.ckpt",
    params:
        output_dir = scan_output_dir,
        npz = lambda wc: token_clf_sizes[wc.size],
        codebook_dim = TOKEN_CLF_CODEBOOK_DIM,
        max_epochs = TOKEN_CLF_MAX_EPOCHS,
        net_overrides = _clf_net_overrides(),
        slurm = SLURM,
    wildcard_constraints:
        size = "|".join(token_clf_sizes),
    shell:
        """
        {params.slurm} -J token_clf_{wildcards.size} \
            -o {params.output_dir}/classifiers/token_clf_{wildcards.size}/slurm_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=classifiers \
                network_name=token_clf_{wildcards.size} \
                datamodule=token_npz \
                datamodule.data_path={params.npz} \
                model=vector_classifier \
                model.tokenizer_ckpt=null \
                model.codebook_dim={params.codebook_dim} \
                {params.net_overrides} \
                trainer.max_epochs={params.max_epochs} \
                +trainer.num_sanity_val_steps=0 \
                trainer.enable_progress_bar=false \
                callbacks=classify"
        """

rule test_token_classifier:
    input:
        success = scan_output_dir / "classifiers/token_clf_{size}/SUCCESS.txt",
        ckpt = scan_output_dir / "classifiers/token_clf_{size}/checkpoints/best.ckpt",
        sidecar = TOKEN_NPZ_DIR + "/mc-flavtag-ttbar-{size}_npy/EXTRACT_SUCCESS.txt",
    output:
        scan_output_dir / "classifiers/token_clf_{size}/TEST_SUCCESS.txt",
    params:
        output_dir = scan_output_dir,
        npz = lambda wc: token_clf_sizes[wc.size],
        codebook_dim = TOKEN_CLF_CODEBOOK_DIM,
        net_overrides = _clf_net_overrides(),
        slurm = SLURM,
    wildcard_constraints:
        size = "|".join(token_clf_sizes),
    shell:
        """
        {params.slurm} -J test_token_clf_{wildcards.size} \
            -o {params.output_dir}/classifiers/token_clf_{wildcards.size}/slurm_test_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=classifiers \
                network_name=token_clf_{wildcards.size}/test \
                datamodule=token_npz \
                datamodule.data_path={params.npz} \
                model=vector_classifier \
                model.tokenizer_ckpt=null \
                model.codebook_dim={params.codebook_dim} \
                {params.net_overrides} \
                ckpt_path={input.ckpt} \
                test_only=true \
                callbacks=classify \
                trainer.enable_progress_bar=false"
        """

# ── Combined full-dataset training (small + medium + large ≈ 200M jets) ───────
# Trains one VectorClassifier on the union of all three token files. All files share
# the same codebook (verified), are split independently with the same fractions, and
# are interleaved + shuffle-buffered into one stream by the token_npz datamodule.
TOKEN_CLF_FULL_SIZES = ["large", "medium", "small"]
TOKEN_CLF_FULL_LIST = "[" + ",".join(token_clf_sizes[s] for s in TOKEN_CLF_FULL_SIZES) + "]"

# Larger classifier network for the full ~200M-jet run (mirrors the "large" encoder
# geometry). Kept separate from the shared clf_network so the smaller per-size and
# baseline classifier rules are unaffected. Power-of-2 dims, ~11M params (head_dim 64).
token_clf_full_network = {
    "d_model": 512,
    "n_heads": 8,
    "num_layers": 5,
    "dim_feedforward": 1024,
}
TOKEN_CLF_FULL_NET = " ".join(f"model.{k}={v}" for k, v in token_clf_full_network.items())
# Extra CPUs for the token dataloader workers (on-the-fly z_q reconstruction is CPU-bound;
# the base SLURM has no --cpus-per-task, which starves the GPU at num_workers>1).
TOKEN_CLF_FULL_SLURM = f"sbatch --wait -A {SLURM_ACCOUNT} -p {SLURM_PARTITION} -t 7000 --mem=100G --gres=gpu:1 --cpus-per-task=16 -D {WORKSPACE}"

# Optional suffix to fork a parallel run into its own output dir + wandb run WITHOUT
# clobbering an in-progress job (e.g. `--config run_suffix=_v2`). Empty = default names.
RUN_SUFFIX = config.get("run_suffix", "")

rule all_token_classifier_full:
    input:
        scan_output_dir / f"classifiers/token_clf_full{RUN_SUFFIX}/SUCCESS.txt",

rule all_token_classifier_full_test:
    input:
        scan_output_dir / "classifiers/token_clf_full/TEST_SUCCESS.txt",

rule train_token_classifier_full:
    input:
        sidecars = expand(
            TOKEN_NPZ_DIR + "/mc-flavtag-ttbar-{size}_npy/EXTRACT_SUCCESS.txt",
            size=TOKEN_CLF_FULL_SIZES,
        ),
    output:
        scan_output_dir / f"classifiers/token_clf_full{RUN_SUFFIX}/SUCCESS.txt",
        scan_output_dir / f"classifiers/token_clf_full{RUN_SUFFIX}/checkpoints/best.ckpt",
    params:
        output_dir = scan_output_dir,
        data_paths = TOKEN_CLF_FULL_LIST,
        codebook_dim = TOKEN_CLF_CODEBOOK_DIM,
        max_epochs = TOKEN_CLF_MAX_EPOCHS,
        net_overrides = TOKEN_CLF_FULL_NET,
        token_npz_dir = TOKEN_NPZ_DIR,
        name = "token_clf_full" + RUN_SUFFIX,
        slurm = TOKEN_CLF_FULL_SLURM,
    shell:
        # Stage the mmap'd token sidecars (~64 GB) to local NVMe /lscratch and point the
        # datamodule at them via sidecar_root, so the random-access reads hit fast local
        # disk instead of shared /fs/ddn (where scattered reads are the throughput wall).
        # Data content is byte-identical; only the read location changes.
        """
        {params.slurm} -J {params.name} \
            -o {params.output_dir}/classifiers/{params.name}/slurm_%j.log \
            --wrap='
                LOCAL=/lscratch/{params.name}_$$ && mkdir -p $LOCAL && \
                trap "rm -rf $LOCAL" EXIT && \
                echo "Staging token sidecars to $LOCAL ..." && \
                cp -r {params.token_npz_dir}/mc-flavtag-ttbar-large_npy \
                      {params.token_npz_dir}/mc-flavtag-ttbar-medium_npy \
                      {params.token_npz_dir}/mc-flavtag-ttbar-small_npy $LOCAL/ && \
                pixi run python scripts/train.py \
                    output_dir={params.output_dir} \
                    project_name=classifiers \
                    network_name={params.name} \
                    datamodule=token_npz \
                    datamodule.data_paths={params.data_paths} \
                    datamodule.sidecar_root=$LOCAL \
                    model=vector_classifier \
                    model.tokenizer_ckpt=null \
                    model.codebook_dim={params.codebook_dim} \
                    {params.net_overrides} \
                    trainer.max_epochs={params.max_epochs} \
                    trainer.gradient_clip_val=5.0 \
                    model.scheduler.total_steps=$((136529 * {params.max_epochs})) \
                    +trainer.num_sanity_val_steps=0 \
                    trainer.enable_progress_bar=false \
                    callbacks=classify'
        """

rule test_token_classifier_full:
    input:
        success = scan_output_dir / "classifiers/token_clf_full/SUCCESS.txt",
        ckpt = scan_output_dir / "classifiers/token_clf_full/checkpoints/best.ckpt",
        sidecars = expand(
            TOKEN_NPZ_DIR + "/mc-flavtag-ttbar-{size}_npy/EXTRACT_SUCCESS.txt",
            size=TOKEN_CLF_FULL_SIZES,
        ),
    output:
        scan_output_dir / "classifiers/token_clf_full/TEST_SUCCESS.txt",
    params:
        output_dir = scan_output_dir,
        data_paths = TOKEN_CLF_FULL_LIST,
        codebook_dim = TOKEN_CLF_CODEBOOK_DIM,
        net_overrides = TOKEN_CLF_FULL_NET,
        slurm = SLURM,
    shell:
        """
        {params.slurm} -J test_token_clf_full \
            -o {params.output_dir}/classifiers/token_clf_full/slurm_test_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name=classifiers \
                network_name=token_clf_full/test \
                datamodule=token_npz \
                datamodule.data_paths={params.data_paths} \
                model=vector_classifier \
                model.tokenizer_ckpt=null \
                model.codebook_dim={params.codebook_dim} \
                {params.net_overrides} \
                ckpt_path={input.ckpt} \
                test_only=true \
                callbacks=classify \
                trainer.enable_progress_bar=false"
        """

# ══════════════════════════════════════════════════════════════════════════════
# Generalized token export + "full" classifier training for ARBITRARY scan points
# ══════════════════════════════════════════════════════════════════════════════
# Generalizes the export/extract/train_token_classifier_full steps above (which are
# hardcoded to one TOKEN_NPZ_DIR at a time, requiring a manual constant edit +
# --config run_suffix=... per tokenizer) into wildcard-parametrized rules keyed by
# {tok_model} (the vqvae_scan point name). New scan points just get added to
# TOKEN_CLF_FULL_SCAN_POINTS below — no Snakefile edits needed per run.
GROUP_TOKEN_DIR = "/fs/ddn/sdf/group/atlas/d/jkrupa/heptokens"

def group_token_dir(tok_model):
    return f"{GROUP_TOKEN_DIR}/{tok_model}"

# label -> vqvae_scan point name. Add new scan points here.
TOKEN_CLF_FULL_SCAN_POINTS = {
    "cb1024_nq4": "transformer_vqvae_enc_large_cb1024_cd8_nq4_lr0.0003_cw1.0_nj10000000",
    "cb8192_nq4": "transformer_vqvae_enc_large_cb8192_cd8_nq4_lr0.0003_cw1.0_nj10000000",
    "cb1024_nq3": "transformer_vqvae_enc_large_cb1024_cd8_nq3_lr0.0003_cw1.0_nj10000000",
}

rule export_tokens_scan:
    input:
        ckpt = scan_output_dir / "vqvae_scan/{tok_model}/checkpoints/best.ckpt",
    output:
        GROUP_TOKEN_DIR + "/{tok_model}/mc-flavtag-ttbar-{split}.npz",
    params:
        h5_path = lambda wc: TOKENIZE_H5_FILES[wc.split],
        output_dir = lambda wc: group_token_dir(wc.tok_model),
        slurm = f"sbatch --wait -A {SLURM_ACCOUNT} -p {SLURM_PARTITION} -t 7000 --mem=100G --gres=gpu:1 --cpus-per-task=8 -D {WORKSPACE}",
    wildcard_constraints:
        tok_model = "[^/]+",
        split = "small|medium|large",
    shell:
        """
        mkdir -p {params.output_dir} && \
        {params.slurm} -J export_{wildcards.tok_model}_{wildcards.split} \
            -o {params.output_dir}/slurm_export_{wildcards.split}_%j.log \
            --wrap='
                LOCAL=/lscratch/export_$$ && mkdir -p $LOCAL && \
                trap "rm -rf $LOCAL" EXIT && \
                export LOCAL_TMPDIR=$LOCAL && \
                echo "Copying {params.h5_path} to $LOCAL ..." && \
                cp {params.h5_path} $LOCAL/ && \
                LOCAL_H5=$LOCAL/$(basename {params.h5_path}) && \
                echo "Running tokenization from $LOCAL_H5, tmp=$LOCAL_TMPDIR ..." && \
                pixi run python scripts/export_tokens.py \
                    ckpt_path={input.ckpt} \
                    output_dir={params.output_dir} \
                    datamodule.data_path=$LOCAL_H5 \
                    datamodule.batch_size=2048 \
                    datamodule.train_frac=0.0 \
                    datamodule.val_frac=0.0 \
                    datamodule.test_frac=1.0 \
                    datamodule.seed=null \
                    datamodule.chunk_size=5000000 \
                    datamodule.num_workers=2 \
                    datamodule.transforms.preprocess.cst_fn.filename=/sdf/data/atlas/u/jkrupa/heptokens/resources/cst_quantiles.joblib \
                    datamodule.transforms.preprocess.jet_fn.filename=/sdf/data/atlas/u/jkrupa/heptokens/resources/jet_quantiles.joblib
            '
        """

rule extract_token_sidecars_scan:
    input:
        npz = GROUP_TOKEN_DIR + "/{tok_model}/mc-flavtag-ttbar-{size}.npz",
    output:
        marker = GROUP_TOKEN_DIR + "/{tok_model}/mc-flavtag-ttbar-{size}_npy/EXTRACT_SUCCESS.txt",
    params:
        slurm = f"sbatch --wait -A {SLURM_ACCOUNT} -p {SLURM_PARTITION} -t 2000 --mem=16G --gres=gpu:1 -D {WORKSPACE}",
        log_dir = lambda wc: group_token_dir(wc.tok_model),
    wildcard_constraints:
        tok_model = "[^/]+",
        size = "small|medium|large",
    shell:
        """
        {params.slurm} -J extract_{wildcards.tok_model}_{wildcards.size} \
            -o {params.log_dir}/extract_{wildcards.size}_%j.log \
            --wrap="pixi run python scripts/extract_token_sidecars.py {input.npz} \
                && touch {output.marker}"
        """

