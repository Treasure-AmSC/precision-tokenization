# ══════════════════════════════════════════════════════════════════════════════
# JetSet Dataset Tokenization (existing)
# ══════════════════════════════════════════════════════════════════════════════
rule tokenize_all:
    input:
        expand(
            scan_output_dir / "tokenized/{tok_model}/mc-flavtag-ttbar-{split}.npz",
            tok_model=TOKENIZE_MODELS,
            split=TOKENIZE_H5_FILES.keys(),
        ),

rule tokenize_dataset:
    input:
        ckpt = scan_output_dir / "vqvae_scan/{tok_model}/checkpoints/best.ckpt",
    output:
        scan_output_dir / "tokenized/{tok_model}/mc-flavtag-ttbar-{split}.npz",
    params:
        h5_path = lambda wc: TOKENIZE_H5_FILES[wc.split],
        output_dir = lambda wc: str(scan_output_dir / "tokenized" / wc.tok_model),
        slurm = f"sbatch --wait -A {SLURM_ACCOUNT} -p {SLURM_PARTITION} -t 7000 --mem=100G --gres=gpu:1 --cpus-per-task=8 -D {WORKSPACE}",
    wildcard_constraints:
        tok_model = "[^/]+",
        split = "small|medium|large",
    shell:
        """
        {params.slurm} -J tokenize_{wildcards.split} \
            -o {params.output_dir}/slurm_tokenize_{wildcards.split}_%j.log \
            --wrap='
                LOCAL=/lscratch/tokenize_$$ && mkdir -p $LOCAL && \
                trap "rm -rf $LOCAL" EXIT && \
                export LOCAL_TMPDIR=$LOCAL && \
                echo "Copying {params.h5_path} to $LOCAL ..." && \
                cp {params.h5_path} $LOCAL/ && \
                LOCAL_H5=$LOCAL/$(basename {params.h5_path}) && \
                echo "Running tokenization from $LOCAL_H5, tmp=$LOCAL_TMPDIR ..." && \
                pixi run python scripts/export_tokens.py \
                    ckpt_path={input.ckpt} \
                    output_dir={params.output_dir} \
                    datamodule.data_path=$LOCAL_H5 \
                    datamodule.batch_size=2048 \
                    datamodule.train_frac=0.0 \
                    datamodule.val_frac=0.0 \
                    datamodule.test_frac=1.0 \
                    datamodule.seed=null \
                    datamodule.chunk_size=5000000 \
                    datamodule.num_workers=2 \
                    datamodule.transforms.preprocess.cst_fn.filename=/sdf/data/atlas/u/jkrupa/heptokens/resources/cst_quantiles.joblib \
                    datamodule.transforms.preprocess.jet_fn.filename=/sdf/data/atlas/u/jkrupa/heptokens/resources/jet_quantiles.joblib
            '
        """

# ══════════════════════════════════════════════════════════════════════════════
# COCOA pflow input-tokenizer sweep — EVAL + PANEL
# ══════════════════════════════════════════════════════════════════════════════
# The full sweep is now Snakemake-managed end to end:
#   export_pflow_point : re-tokenize track+topo (cs tokenizer) + truthpart into the
#                        per-point preprocessed_dir (scripts/pflow_export_point.sh).
#   train_pflow_point  : generate per-point configs + train the 4M
#                        (scripts/pflow_train_point.sh); auto glob-discovered ckpts.
#   eval_pflow_point   : 3-stage eval of ONE trained point (scripts/pflow_eval_point.sh)
#                        -> cs<cs>/eval/{metrics.json, token_metrics.json};
#                        auto-picks the best-val 4M checkpoint (lowest val_total_loss).
#   pflow_sweep_panel  : aggregate all points -> sweep_metrics.csv + sweep_panel.png.
# The old scripts/pflow_input_sweep.sh (one sbatch afterok chain per cs) remains for
# manual use; export/train here run the byte-identical commands split into two scripts.
# Adjust the grid with, e.g.:  --config pflow_sweep_cs='[64,256,1024,4096]'
# 4M pflow outputs (checkpoints + wandb) live on ddn group space, not the small
# 200G /sdf/data/atlas volume. Exports already live on ddn (PFLOW_SWEEP_TOK_ROOT).
PFLOW_SWEEP_ROOT  = Path("/fs/ddn/sdf/group/atlas/d/jkrupa/hep4m_pflow_sweep")
# codebook_dim is per-modality: it only selects which pretrained tokenizer ckpt to
# load (the 4M consumes token indices, not cd-dim vectors, and info_fraction ignores
# cd), so track/topo need not match. Defaults = per-modality optima (track cd=4,
# topo cd=8). Override with --config pflow_track_cd=8 pflow_topo_cd=8 for the old run.
PFLOW_SWEEP_CD_TRACK = config.get("pflow_track_cd", 4)
PFLOW_SWEEP_CD_TOPO  = config.get("pflow_topo_cd", 8)
PFLOW_SWEEP_NQ    = config.get("pflow_nq", 4)
pflow_sweep_cs    = config.get("pflow_sweep_cs", [64, 256, 1024, 4096])
PFLOW_EVAL_REDUCE = config.get("pflow_eval_reduce", -1)   # val events for eval (-1 = all)
PFLOW_TRAIN_EPOCHS = config.get("pflow_train_epochs", 300)      # 4M num_epochs (cap; early stopping ends training)
PFLOW_TRAIN_PATIENCE = config.get("pflow_train_patience", 3)  # epochs without val_total_loss improvement
PFLOW_TRAIN_N      = config.get("pflow_train_num_events", "all")  # 4M train export size; "all" = full ~20M split
PFLOW_SWEEP_TOK_ROOT = "/fs/ddn/sdf/group/atlas/d/jkrupa/hep4m_sweep"
# Per-sweep tag: outputs/exports/configs are namespaced under it so runs with
# different nq/cd don't collide (the pre-existing untagged nq3/cd8 sweep stays put).
PFLOW_TAG = config.get("pflow_tag", f"nq{PFLOW_SWEEP_NQ}_trkcd{PFLOW_SWEEP_CD_TRACK}_topocd{PFLOW_SWEEP_CD_TOPO}")
PFLOW_SWEEP_DIR = PFLOW_SWEEP_ROOT / PFLOW_TAG
PFLOW_TOK_DIR   = PFLOW_SWEEP_TOK_ROOT + "/" + PFLOW_TAG
# Export runs the heptokens env; train runs the HEP4M env (script cd's to $HEP4M).
_PFLOW_EXCLUDE = f" --exclude={config['exclude_nodes']}" if config.get("exclude_nodes") else ""
PFLOW_EXPORT_SLURM = f"sbatch --wait -A {SLURM_ACCOUNT} -p {SLURM_PARTITION} -t 480 --mem=100G --gres=gpu:1 --cpus-per-task=8 -D {WORKSPACE}" + _PFLOW_EXCLUDE
PFLOW_TRAIN_SLURM  = f"sbatch --wait -A {SLURM_ACCOUNT} -p {SLURM_PARTITION} -t 7000 --mem=100G --gres=gpu:1 --cpus-per-task=8 -D {WORKSPACE}" + _PFLOW_EXCLUDE
PFLOW_EVAL_SLURM   = SLURM + _PFLOW_EXCLUDE

def _pflow_track_ckpt(wc):
    return cocoa_output_dir / f"tracks/cocoa_tracks_cb{wc.cs}_cd{PFLOW_SWEEP_CD_TRACK}_nq{PFLOW_SWEEP_NQ}_lr0.001/checkpoints/best.ckpt"

def _pflow_topo_ckpt(wc):
    return cocoa_output_dir / f"topos/cocoa_topos_cb{wc.cs}_cd{PFLOW_SWEEP_CD_TOPO}_nq{PFLOW_SWEEP_NQ}_lr0.001/checkpoints/best.ckpt"

PFLOW_TRUTHPART_CKPT = cocoa_output_dir / "truthpart/cocoa_truthpart_cb128_cd8_nq3_lr0.001/checkpoints/best.ckpt"

rule all_pflow_sweep_eval:
    input:
        PFLOW_SWEEP_DIR / "sweep_panel.png",

rule all_pflow_sweep_train:
    input:
        expand(str(PFLOW_SWEEP_DIR / "cs{cs}/TRAIN_SUCCESS.txt"), cs=pflow_sweep_cs),

rule export_pflow_point:
    input:
        track_ckpt = _pflow_track_ckpt,
        topo_ckpt = _pflow_topo_ckpt,
    output:
        marker = PFLOW_TOK_DIR + "/cs{cs}/EXPORT_SUCCESS.txt",
    params:
        slurm = PFLOW_EXPORT_SLURM,
        train_n = PFLOW_TRAIN_N,
        nq = PFLOW_SWEEP_NQ,
        track_cd = PFLOW_SWEEP_CD_TRACK,
        topo_cd = PFLOW_SWEEP_CD_TOPO,
        tag = PFLOW_TAG,
    wildcard_constraints:
        cs = "|".join(str(c) for c in pflow_sweep_cs),
    shell:
        """
        mkdir -p {PFLOW_TOK_DIR}/cs{wildcards.cs} && \
        {params.slurm} -J pflow_export_{params.tag}_cs{wildcards.cs} \
            -o {PFLOW_TOK_DIR}/cs{wildcards.cs}/slurm_export_%j.log \
            --wrap="bash {WORKSPACE}/scripts/pflow_export_point.sh {wildcards.cs} {params.tag} {params.nq} {params.track_cd} {params.topo_cd} {params.train_n}"
        """

rule train_pflow_point:
    input:
        export = PFLOW_TOK_DIR + "/cs{cs}/EXPORT_SUCCESS.txt",
        track_ckpt = _pflow_track_ckpt,
        topo_ckpt = _pflow_topo_ckpt,
        truthpart_ckpt = ancient(PFLOW_TRUTHPART_CKPT),
    output:
        marker = PFLOW_SWEEP_DIR / "cs{cs}/TRAIN_SUCCESS.txt",
    params:
        slurm = PFLOW_TRAIN_SLURM,
        epochs = PFLOW_TRAIN_EPOCHS,
        patience = PFLOW_TRAIN_PATIENCE,
        nq = PFLOW_SWEEP_NQ,
        track_cd = PFLOW_SWEEP_CD_TRACK,
        topo_cd = PFLOW_SWEEP_CD_TOPO,
        tag = PFLOW_TAG,
    wildcard_constraints:
        cs = "|".join(str(c) for c in pflow_sweep_cs),
    shell:
        """
        mkdir -p {PFLOW_SWEEP_DIR}/cs{wildcards.cs} && \
        {params.slurm} -J pflow_train_{params.tag}_cs{wildcards.cs} \
            -o {PFLOW_SWEEP_DIR}/cs{wildcards.cs}/slurm_train_%j.log \
            --wrap="bash {WORKSPACE}/scripts/pflow_train_point.sh {wildcards.cs} {params.tag} {params.nq} {params.track_cd} {params.topo_cd} {params.epochs} {params.patience}"
        """

rule eval_pflow_point:
    input:
        train = PFLOW_SWEEP_DIR / "cs{cs}/TRAIN_SUCCESS.txt",
    output:
        metrics = PFLOW_SWEEP_DIR / "cs{cs}/eval/metrics.json",
    params:
        slurm = PFLOW_EVAL_SLURM,
        reduce = PFLOW_EVAL_REDUCE,
        tag = PFLOW_TAG,
    wildcard_constraints:
        cs = "|".join(str(c) for c in pflow_sweep_cs),
    shell:
        """
        {params.slurm} -J pflow_eval_{params.tag}_cs{wildcards.cs} \
            -o {PFLOW_SWEEP_DIR}/cs{wildcards.cs}/eval/slurm_eval_%j.log \
            --wrap="bash {WORKSPACE}/scripts/pflow_eval_point.sh {wildcards.cs} {params.tag} {params.reduce}"
        """

rule pflow_sweep_panel:
    input:
        expand(str(PFLOW_SWEEP_DIR / "cs{cs}/eval/metrics.json"), cs=pflow_sweep_cs),
    output:
        png = PFLOW_SWEEP_DIR / "sweep_panel.png",
        csv = PFLOW_SWEEP_DIR / "sweep_metrics.csv",
    params:
        cs = " ".join(str(c) for c in pflow_sweep_cs),
    shell:
        """
        pixi run python scripts/pflow_sweep_panel.py \
            --sweep_root {PFLOW_SWEEP_DIR} --cs {params.cs} \
            --cd {PFLOW_SWEEP_CD_TOPO} --nq {PFLOW_SWEEP_NQ} \
            --out_csv {output.csv} --out_png {output.png}
        """

# ---- continuous-input pflow: raw (scaled) track/topo features through an MLP input head ----
# Trunk, truthpart target and eval are unchanged. The cs{PFLOW_CONT_CS} token export is reused
# only for row offsets/event numbers; {mod}_cont.npy is added next to it.
PFLOW_CONT_HIDDEN = str(config.get("pflow_cont_hidden", "256"))   # comma-separated, no spaces
PFLOW_CONT_TAG = config.get("pflow_cont_tag", f"cont_mlp{PFLOW_CONT_HIDDEN.replace(',', 'x')}")
PFLOW_CONT_CS = config.get("pflow_cont_cs", 1024)
PFLOW_CONT_PP = f"{PFLOW_TOK_DIR}/cs{PFLOW_CONT_CS}"
PFLOW_CONT_DIR = PFLOW_SWEEP_ROOT / PFLOW_CONT_TAG / f"cs{PFLOW_CONT_CS}"

rule all_pflow_cont:
    input:
        PFLOW_CONT_DIR / "eval/metrics.json",

rule export_pflow_cont:
    input:
        export = PFLOW_CONT_PP + "/EXPORT_SUCCESS.txt",
    output:
        marker = PFLOW_CONT_PP + "/CONT_EXPORT_SUCCESS.txt",
    params:
        slurm = PFLOW_EXPORT_SLURM,
        pp = PFLOW_CONT_PP,
        cmd = f"pixi run --manifest-path {WORKSPACE}/pyproject.toml python {WORKSPACE}/scripts/build_hep4m_preprocessed.py --cont_only --modalities track topo --num_workers 8 --output_dir {PFLOW_CONT_PP}",
    shell:
        """
        {params.slurm} -J pflow_cont_export \
            -o {params.pp}/slurm_cont_export_%j.log \
            --wrap="{params.cmd} --split_dir val_100K_cells256 --split_name val && \
                    {params.cmd} --split_dir train_topup2_20M_cells256 --split_name train && \
                    touch {output.marker}"
        """

rule train_pflow_cont:
    input:
        export = PFLOW_CONT_PP + "/CONT_EXPORT_SUCCESS.txt",
        truthpart_ckpt = ancient(PFLOW_TRUTHPART_CKPT),
    output:
        marker = PFLOW_CONT_DIR / "TRAIN_SUCCESS.txt",
    params:
        slurm = PFLOW_TRAIN_SLURM,
        env = f"PFLOW_PP_DIR={PFLOW_CONT_PP} PFLOW_INPUT_REPR=continuous PFLOW_CONT_HIDDEN={PFLOW_CONT_HIDDEN}",
        args = f"{PFLOW_CONT_CS} {PFLOW_CONT_TAG} {PFLOW_SWEEP_NQ} {PFLOW_SWEEP_CD_TRACK} {PFLOW_SWEEP_CD_TOPO} {PFLOW_TRAIN_EPOCHS} {PFLOW_TRAIN_PATIENCE}",
        tag = PFLOW_CONT_TAG,
        outdir = PFLOW_CONT_DIR,
    shell:
        """
        mkdir -p {params.outdir} && \
        {params.slurm} -J pflow_train_{params.tag} \
            -o {params.outdir}/slurm_train_%j.log \
            --wrap="{params.env} bash {WORKSPACE}/scripts/pflow_train_point.sh {params.args}"
        """

rule eval_pflow_cont:
    input:
        train = PFLOW_CONT_DIR / "TRAIN_SUCCESS.txt",
    output:
        metrics = PFLOW_CONT_DIR / "eval/metrics.json",
    params:
        slurm = PFLOW_EVAL_SLURM,
        env = f"PFLOW_PP_DIR={PFLOW_CONT_PP}",
        args = f"{PFLOW_CONT_CS} {PFLOW_CONT_TAG} {PFLOW_EVAL_REDUCE}",
        tag = PFLOW_CONT_TAG,
        outdir = PFLOW_CONT_DIR,
    shell:
        """
        mkdir -p {params.outdir}/eval && \
        {params.slurm} -J pflow_eval_{params.tag} \
            -o {params.outdir}/eval/slurm_eval_%j.log \
            --wrap="{params.env} bash {WORKSPACE}/scripts/pflow_eval_point.sh {params.args}"
        """

# ══════════════════════════════════════════════════════════════════════════════
# Design-rules figure: explicit run lists (not grid extensions)
# ══════════════════════════════════════════════════════════════════════════════
# Shells are copies of train_tokenizer/test_tokenizer and train/test_cocoa_{tracks,topos}
# with cst_fn and free-form `extra` / `test_extra` override slots (empty unless needed).
import yaml
import itertools

# These shells only run `sbatch --wait` for the ampere job, so run them on the driver host
# instead of as idle turing wrapper jobs.
localrules: posout_scaler, all_design_rules, all_design_rules_test, all_design_batch2, all_design_batch2_test
localrules: all_design_recipe, all_design_recipe_test, all_nofp_test
localrules: train_design_jetset, test_design_jetset, train_design_tracks, test_design_tracks
localrules: train_design_topos, test_design_topos, test_nofp_jetset, test_nofp_tracks, test_nofp_topos

JETSET_CST_FN = f"{WORKSPACE}/resources/cst_quantiles.joblib"
JETSET_JET_FN = f"{WORKSPACE}/resources/jet_quantiles.joblib"
# Relative, as the reference COCOA tests ran (their test_metrics nest under test/results/...).
COCOA_TEST_OUTPUT_DIR = "results/cocoa_scan"
JETSET_LARGE_ARCH = " ".join(
    f"model.{side}.model.{k}={v}"
    for side in ("encoder", "decoder") for k, v in transformer_sizes["large"].items()
)

# Inner ampere sbatch for the design rules; identical to SLURM unless --config exclude_nodes=... is given.
DESIGN_SLURM = SLURM + (f" --exclude={config['exclude_nodes']}" if config.get("exclude_nodes") else "")

def _design(group, project, cb, cd, nq, cst_fn, extra="", test_extra="", recon_idx="", max_epochs=50, patience=15,
            slurm=None, test_slurm=None):
    return dict(group=group, project=project, cb=cb, cd=cd, nq=nq, cst_fn=cst_fn, extra=extra,
                test_extra=test_extra, recon_idx=recon_idx, max_epochs=max_epochs, patience=patience,
                slurm=slurm or DESIGN_SLURM, test_slurm=test_slurm or DESIGN_SLURM)

def _jetset_name(cb, cd, nq, suffix=""):
    return f"transformer_vqvae_enc_large_cb{cb}_cd{cd}_nq{nq}_lr0.0003_cw1.0_nj10000000{suffix}"

TOPO_POSIN_RECON_IDX = (
    "+callbacks.reconstruction_monitor.deta_idx=0 +callbacks.reconstruction_monitor.dphi_idx=1 "
    "+callbacks.reconstruction_monitor.energy_idx=2"
)

design_jetset = {
    **{_jetset_name(32768, 8, nq): _design("qscan", "vqvae_scan", 32768, 8, nq, JETSET_CST_FN) for nq in (2, 6, 8)},
    _jetset_name(32768, 4, 4, "_seed1234"): _design("qscan", "vqvae_scan", 32768, 4, 4, JETSET_CST_FN, extra="seed=1234"),
}
design_tracks = {
    f"cocoa_tracks_cb4096_cd4_nq{nq}_lr0.001": _design("qscan", "tracks", 4096, 4, nq, COCOA_CST_FN) for nq in (6, 8)
}
design_topos = {
    f"cocoa_topos_cb4096_cd8_nq{nq}_lr0.001": _design("qscan", "topos", 4096, 8, nq, COCOA_TOPO_CST_FN, recon_idx=TOPO_POSIN_RECON_IDX)
    for nq in (6, 8)
}
# Topo repeat spread at the selected point; COCOA splits are by directory, so only the global seed changes.
for seed in (1234, 5678):
    design_topos[f"cocoa_topos_cb4096_cd8_nq4_lr0.001_seed{seed}"] = _design(
        "seed", "topos_seed", 4096, 8, 4, COCOA_TOPO_CST_FN, extra=f"seed={seed}", recon_idx=TOPO_POSIN_RECON_IDX,
    )

# ── Positions-out: (eta, phi) / (deta, dphi) removed from csts and binned by PositionTokenizer ──
# Bits stored per element = Q*log2(K) + sum_i log2(n_bins_i): COCOA stores (eta, cos phi, sin phi)
# = 30 bits (cos/sin redundant: ~2 of the 3 coordinates carry the information); JetSet (deta, dphi) = 20.
POSOUT_SCALERS = {  # sliced copies of the positions-in scalers, see scripts/slice_scaler.py
    "cst_quantiles": "1 2",
    "cocoa_cst_log_standard": "1 2",
    "cocoa_topo_log_standard": "0 1",
}

def _posout_scaler(stem):
    return f"{WORKSPACE}/resources/{stem}_posout.joblib"

def _pos_tokenizer(ranges):
    r = ",".join(f"[{lo},{hi}]" for lo, hi in ranges)
    return f"'+callbacks.reconstruction_monitor.pos_tokenizer={{_target_:heptokens.models.pos_tokenizer.PositionTokenizer,ranges:[{r}],n_bins:1024}}'"

COCOA_POS_TOKENIZER = _pos_tokenizer([(-3.0, 3.0), (-1.0, 1.0), (-1.0, 1.0)])  # = heptokens-cocoa cocoa_topo_scan.yaml
JETSET_POS_TOKENIZER = _pos_tokenizer([(-0.5, 0.5), (-0.5, 0.5)])  # |deta|,|dphi| < 0.486 in the training data

with open(WORKSPACE / "configs/datamodule/atlas_mappable.yaml") as _f:
    _jetset_cst = [f for f in yaml.safe_load(_f)["cst_features"] if f not in ("deta", "dphi")]
JETSET_POSOUT = (
    f"'datamodule.cst_features=[{','.join(_jetset_cst)}]' '+datamodule.position_features=[deta,dphi]' "
    + JETSET_POS_TOKENIZER
)
TRACKS_POSOUT = (
    "'datamodule.features=[track_pt,track_d0,track_z0]' '+datamodule.position_features=[track_eta,track_phi]' "
    + COCOA_POS_TOKENIZER
)
TOPOS_POSOUT = (
    "'datamodule.features=[topo_e,topo_rho,topo_sigma_eta,topo_sigma_phi,topo_ecal_e,topo_hcal_e]' "
    "'+datamodule.position_features=[topo_eta,topo_phi]' " + COCOA_POS_TOKENIZER
)

for cb, cd in product([8192, 16384, 32768], [4, 8, 16]):
    design_jetset[_jetset_name(cb, cd, 4, "_posout")] = _design(
        "posout", "vqvae_scan", cb, cd, 4, _posout_scaler("cst_quantiles"),
        extra=JETSET_POSOUT, test_extra=JETSET_POSOUT,
    )
for cb, cd in product([256, 1024, 4096], [2, 4, 8]):
    design_tracks[f"cocoa_tracks_posout_cb{cb}_cd{cd}_nq4_lr0.001"] = _design(
        "posout", "tracks_posout", cb, cd, 4, _posout_scaler("cocoa_cst_log_standard"),
        extra=TRACKS_POSOUT, test_extra=TRACKS_POSOUT,
    )
for cb, cd in product([256, 1024, 4096], [4, 8, 12]):
    design_topos[f"cocoa_topos_posout_cb{cb}_cd{cd}_nq4_lr0.001"] = _design(
        "posout", "topos_posout", cb, cd, 4, _posout_scaler("cocoa_topo_log_standard"),
        extra=TOPOS_POSOUT, test_extra=TOPOS_POSOUT,
        recon_idx="+callbacks.reconstruction_monitor.energy_idx=0",
    )

# These tracks Q=3 references were trained with max_epochs=200 / patience=20; retrain at the scan recipe (50 / 15).
for cb, cd in [(64, 4), (256, 2), (256, 4), (1024, 2), (1024, 4)]:
    design_tracks[f"cocoa_tracks_cb{cb}_cd{cd}_nq3_lr0.001_e50"] = _design("recipe", "tracks_e50", cb, cd, 3, COCOA_CST_FN)

# ── Design-figure panels (a), (b), (d) at d = 8, trained to convergence: 100 epochs, cosine over all 100,
# early stopping effectively off (patience = max_epochs). Topo on turing, tracks on ampere unless
# --config e100_tracks_partition=turing.
E100_EPOCHS = 100

def _sbatch(account, partition, mem):
    s = f"sbatch --wait -A {account} -p {partition} -t 7000 --mem={mem} --gres=gpu:1 -D {WORKSPACE}"
    if partition == "ampere" and config.get("exclude_nodes"):
        s += f" --exclude={config['exclude_nodes']}"
    return s

_E100_SLURM = {
    "ampere": itertools.cycle([_sbatch(SLURM_ACCOUNT, "ampere", "100G")]),
    "turing": itertools.cycle([_sbatch(SLURM_ACCOUNT, "turing", "90G")]),
}
_E100_TEST_SLURM = _sbatch(SLURM_ACCOUNT, "turing", "90G")
_E100_TRACKS_PART = config.get("e100_tracks_partition", "ampere")
_E100_POSIN = [(4096, nq) for nq in (2, 3, 4, 6, 8)] + [(cb, 4) for cb in (64, 256, 1024)]

def _e100(project, cb, nq, cst_fn, partition, **kw):
    return _design("e100", project, cb, 8, nq, cst_fn, max_epochs=E100_EPOCHS, patience=E100_EPOCHS,
                   slurm=next(_E100_SLURM[partition]), test_slurm=_E100_TEST_SLURM, **kw)

for cb, nq in _E100_POSIN:
    design_tracks[f"cocoa_tracks_cb{cb}_cd8_nq{nq}_lr0.001_e100"] = _e100("tracks_e100", cb, nq, COCOA_CST_FN, _E100_TRACKS_PART)
    design_topos[f"cocoa_topos_cb{cb}_cd8_nq{nq}_lr0.001_e100"] = _e100(
        "topos_e100", cb, nq, COCOA_TOPO_CST_FN, "turing", recon_idx=TOPO_POSIN_RECON_IDX)
for cb in (256, 1024, 4096):
    design_tracks[f"cocoa_tracks_posout_cb{cb}_cd8_nq4_lr0.001_e100"] = _e100(
        "tracks_e100", cb, 4, _posout_scaler("cocoa_cst_log_standard"), _E100_TRACKS_PART,
        extra=TRACKS_POSOUT, test_extra=TRACKS_POSOUT)
    design_topos[f"cocoa_topos_posout_cb{cb}_cd8_nq4_lr0.001_e100"] = _e100(
        "topos_e100", cb, 4, _posout_scaler("cocoa_topo_log_standard"), "turing",
        extra=TOPOS_POSOUT, test_extra=TOPOS_POSOUT, recon_idx="+callbacks.reconstruction_monitor.energy_idx=0")

def _design_targets(lookup, root, marker, groups):
    return [str(root / c["project"] / name / marker) for name, c in lookup.items() if c["group"] in groups]

def _design_param(lookup, key):
    return lambda wc: lookup[wc.design_name][key]

def _design_cst_fn_input(lookup):
    return lambda wc: ancient(lookup[wc.design_name]["cst_fn"])

rule posout_scaler:
    input:
        f"{WORKSPACE}/resources/{{stem}}.joblib",
    output:
        f"{WORKSPACE}/resources/{{stem}}_posout.joblib",
    params:
        drop = lambda wc: POSOUT_SCALERS[wc.stem],
    wildcard_constraints:
        stem = "|".join(POSOUT_SCALERS),
    shell:
        "pixi run python scripts/slice_scaler.py {input} {output} --drop {params.drop}"

rule all_design_rules:
    input:
        _design_targets(design_jetset, scan_output_dir, "SUCCESS.txt", ["qscan"]),
        _design_targets(design_tracks, cocoa_output_dir, "SUCCESS.txt", ["qscan"]),
        _design_targets(design_topos, cocoa_output_dir, "SUCCESS.txt", ["qscan"]),

rule all_design_rules_test:
    input:
        _design_targets(design_jetset, scan_output_dir, "TEST_SUCCESS.txt", ["qscan"]),
        _design_targets(design_tracks, cocoa_output_dir, "TEST_SUCCESS.txt", ["qscan"]),
        _design_targets(design_topos, cocoa_output_dir, "TEST_SUCCESS.txt", ["qscan"]),

rule all_design_batch2:
    input:
        _design_targets(design_jetset, scan_output_dir, "SUCCESS.txt", ["posout", "seed"]),
        _design_targets(design_tracks, cocoa_output_dir, "SUCCESS.txt", ["posout", "seed"]),
        _design_targets(design_topos, cocoa_output_dir, "SUCCESS.txt", ["posout", "seed"]),

rule all_design_batch2_test:
    input:
        _design_targets(design_jetset, scan_output_dir, "TEST_SUCCESS.txt", ["posout", "seed"]),
        _design_targets(design_tracks, cocoa_output_dir, "TEST_SUCCESS.txt", ["posout", "seed"]),
        _design_targets(design_topos, cocoa_output_dir, "TEST_SUCCESS.txt", ["posout", "seed"]),

rule all_design_recipe:
    input:
        _design_targets(design_tracks, cocoa_output_dir, "SUCCESS.txt", ["recipe"]),

rule all_design_recipe_test:
    input:
        _design_targets(design_tracks, cocoa_output_dir, "TEST_SUCCESS.txt", ["recipe"]),

rule train_design_jetset:
    input:
        cst_fn = _design_cst_fn_input(design_jetset),
    output:
        scan_output_dir / "{design_project}/{design_name}/SUCCESS.txt",
        ckpt = scan_output_dir / "{design_project}/{design_name}/checkpoints/best.ckpt",
    params:
        output_dir = scan_output_dir,
        codebook_size = _design_param(design_jetset, "cb"),
        codebook_dim = _design_param(design_jetset, "cd"),
        num_quantizers = _design_param(design_jetset, "nq"),
        cst_fn = _design_param(design_jetset, "cst_fn"),
        extra = _design_param(design_jetset, "extra"),
        slurm = DESIGN_SLURM,
    wildcard_constraints:
        design_project = "|".join(sorted({c["project"] for c in design_jetset.values()})),
        design_name = "|".join(design_jetset),
    shell:
        """
        {params.slurm} -J {wildcards.design_name} \
            -o {params.output_dir}/{wildcards.design_project}/{wildcards.design_name}/slurm_%j.log \
            --wrap="pixi run python scripts/train.py \
                output_dir={params.output_dir} \
                project_name={wildcards.design_project} \
                network_name={wildcards.design_name} \
                model=transformer_vqvae \
                datamodule=atlas_mappable \
                datamodule.num_jets=10000000 \
                {JETSET_LARGE_ARCH} \
                model.codebook_size={params.codebook_size} \
                model.codebook_dim={params.codebook_dim} \
                model.num_quantizers={params.num_quantizers} \
                model.learning_rate=0.0003 \
                model.optimizer.lr=0.0003 \
                +model.commitment_weight=1.0 \
                trainer.max_epochs=200 \
                trainer.check_val_every_n_epoch=1 \
                trainer.val_check_interval=1.0 \
                trainer.limit_val_batches=1.0 \
                +trainer.num_sanity_val_steps=0 \
                trainer.gradient_clip_val=1.0 \
                trainer.enable_progress_bar=false \
                callbacks=encode \
                callbacks.reconstruction_monitor.log_every_n_epochs=5 \
                +callbacks.reconstruction_monitor.max_batches=100 \
                datamodule.transforms.preprocess.jet_fn.filename='{JETSET_JET_FN}' \
                datamodule.transforms.preprocess.cst_fn.filename='{params.cst_fn}' \
                {params.extra}"
        """

